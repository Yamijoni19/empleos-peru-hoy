<style>
/*<![CDATA[*/

.portal-empleos{
  width:100%;
  max-width:1250px;
  margin:0 auto;
  padding:0 18px 45px;
  font-family:Arial,Helvetica,sans-serif;
  color:#172033;
  overflow:visible;
}

.portal-empleos *{
  box-sizing:border-box;
}

.portal-header{
  height:62px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.portal-logo{
  font-size:20px;
  font-weight:800;
  color:#1976d2;
}

.portal-menu{
  display:flex;
  gap:24px;
}

.portal-menu a{
  color:#4b5563;
  text-decoration:none;
  font-size:13px;
  font-weight:600;
}

.buscador-empleos{
  position:relative;
  background:linear-gradient(135deg,#0f4c81,#1976d2);
  border-radius:19px;
  padding:28px 28px 20px;
  color:#fff;
  box-shadow:0 8px 24px rgba(15,76,129,.16);
  z-index:20;
}

.buscador-empleos h1{
  margin:0 0 7px;
  text-align:center;
  font-size:28px;
  line-height:1.2;
}

.buscador-empleos p{
  margin:0 0 18px;
  text-align:center;
  color:rgba(255,255,255,.86);
  font-size:13px;
}

.buscador-contenedor{
  max-width:900px;
  margin:0 auto;
  display:flex;
  gap:8px;
}

.buscador-input{
  flex:1;
  min-width:0;
  height:45px;
  border:0;
  outline:none;
  border-radius:9px;
  padding:0 15px;
  background:#fff;
  color:#172033;
  font-size:13px;
}

.buscador-boton{
  height:45px;
  border:0;
  border-radius:9px;
  padding:0 20px;
  background:#0b2943;
  color:#fff;
  font-size:11px;
  font-weight:800;
  cursor:pointer;
}

.filtros-contenedor{
  max-width:900px;
  margin:10px auto 0;
  position:relative;
  z-index:50;
}

.filtros-grid{
  display:flex;
  align-items:flex-start;
  justify-content:center;
  gap:7px;
}

.filtro-grupo{
  position:relative;
  min-width:145px;
}

.filtro-grupo-titulo{
  position:relative;
  width:100%;
  height:34px;
  border:1px solid rgba(255,255,255,.23);
  border-radius:7px;
  background:rgba(255,255,255,.13);
  color:#fff;
  padding:0 28px 0 10px;
  text-align:left;
  font-size:10px;
  font-weight:800;
  cursor:pointer;
  line-height:34px;
}

.filtro-grupo-titulo .flecha{
  position:absolute;
  right:10px;
  top:50%;
  width:0;
  height:0;
  border-left:4px solid transparent;
  border-right:4px solid transparent;
  border-top:5px solid currentColor;
  transform:translateY(-50%);
  transition:.2s;
}

.filtro-grupo.abierto .filtro-grupo-titulo{
  background:#fff;
  color:#1976d2;
  border-color:#fff;
}

.filtro-grupo.abierto .filtro-grupo-titulo .flecha{
  transform:translateY(-50%) rotate(180deg);
}

.filtro-grupo.tiene-seleccion .filtro-grupo-titulo .flecha{
  width:11px;
  height:11px;
  border:0;
  right:9px;
  transform:translateY(-50%);
}

.filtro-grupo.tiene-seleccion .filtro-grupo-titulo .flecha:before,
.filtro-grupo.tiene-seleccion .filtro-grupo-titulo .flecha:after{
  content:"";
  position:absolute;
  width:11px;
  height:1.5px;
  background:currentColor;
  left:0;
  top:5px;
}

.filtro-grupo.tiene-seleccion .filtro-grupo-titulo .flecha:before{
  transform:rotate(45deg);
}

.filtro-grupo.tiene-seleccion .filtro-grupo-titulo .flecha:after{
  transform:rotate(-45deg);
}

.filtro-opciones{
  display:none;
  position:absolute;
  top:39px;
  left:0;
  width:100%;
  min-width:145px;
  max-height:245px;
  overflow-y:auto;
  background:#fff;
  border-radius:10px;
  padding:7px;
  box-shadow:0 12px 30px rgba(0,0,0,.18);
  z-index:100;
}

.filtro-grupo.abierto .filtro-opciones{
  display:block;
}

.filtro-opcion{
  display:flex;
  align-items:center;
  gap:7px;
  min-height:30px;
  padding:5px 6px;
  border-radius:6px;
  color:#374151;
  font-size:11px;
  cursor:pointer;
}

.filtro-opcion:hover{
  background:#f1f5f9;
}

.filtro-opcion input{
  width:14px;
  height:14px;
  margin:0;
  accent-color:#1976d2;
  cursor:pointer;
}

.categorias-seccion{
  margin-top:28px;
}

.categorias-titulo{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:12px;
}

.categorias-titulo h2{
  margin:0;
  font-size:19px;
  color:#172033;
}

.categorias-controles{
  display:flex;
  gap:6px;
}

.categoria-flecha{
  width:31px;
  height:31px;
  border:1px solid #e5e7eb;
  border-radius:50%;
  background:#fff;
  color:#1976d2;
  cursor:pointer;
  font-size:17px;
}

.categorias-carrusel{
  display:flex;
  gap:10px;
  overflow-x:auto;
  scrollbar-width:none;
  scroll-behavior:smooth;
  cursor:grab;
}

.categorias-carrusel::-webkit-scrollbar{
  display:none;
}

.categoria-card{
  position:relative;
  flex:0 0 137px;
  height:94px;
  border-radius:13px;
  overflow:hidden;
  border:0;
  cursor:pointer;
  background-size:cover;
  background-position:center;
  box-shadow:0 4px 13px rgba(15,23,42,.12);
}

.categoria-card:after{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(transparent 25%,rgba(0,0,0,.78));
}

.categoria-card span{
  position:absolute;
  left:9px;
  right:9px;
  bottom:8px;
  z-index:2;
  color:#fff;
  font-size:11px;
  line-height:1.15;
  font-weight:800;
  text-align:left;
}

.categoria-card.activa{
  outline:3px solid #1976d2;
  outline-offset:2px;
}

.categoria-todos{
  background-image:url("https://images.unsplash.com/photo-1497366811353-6870744d04b2?auto=format&fit=crop&w=500&q=80");
}

.categoria-ingenieria{
  background-image:url("https://images.unsplash.com/photo-1581094794329-c8112a89af12?auto=format&fit=crop&w=500&q=80");
}

.categoria-salud{
  background-image:url("https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=500&q=80");
}

.categoria-ventas-servicios{
  background-image:url("https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&w=500&q=80");
}

.categoria-administracion-finanzas{
  background-image:url("https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=500&q=80");
}

.categoria-derecho{
  background-image:url("https://images.unsplash.com/photo-1589829545856-d10d557cf95f?auto=format&fit=crop&w=500&q=80");
}

.categoria-educacion{
  background-image:url("https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&w=500&q=80");
}

.categoria-otros{
  background-image:url("https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=500&q=80");
}

/* =====================================================
   IMÁGENES DE CATEGORÍAS DE BECAS
   ===================================================== */

.categoria-universitaria{
  background-image:url("https://images.unsplash.com/photo-1541339907198-e08756dedf3f?auto=format&fit=crop&w=500&q=80");
}

.categoria-movilidad{
  background-image:url("https://images.unsplash.com/photo-1488646953014-85cb44e25828?auto=format&fit=crop&w=500&q=80");
}

.categoria-idiomas{
  background-image:url("https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?auto=format&fit=crop&w=500&q=80");
}

.categoria-investigacion{
  background-image:url("https://images.unsplash.com/photo-1532094349884-543bc11b234d?auto=format&fit=crop&w=500&q=80");
}

.categoria-sociales{
  background-image:url("https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=500&q=80");
}

.categoria-deportivas{
  background-image:url("https://images.unsplash.com/photo-1517649763962-0c623066013b?auto=format&fit=crop&w=500&q=80");
}

.categoria-extranjero{
  background-image:url("https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=500&q=80");
}

.categoria-excelencia{
  background-image:url("https://images.unsplash.com/photo-1607013407627-6ee814329547?auto=format&fit=crop&w=500&q=80");
}

.categoria-otros{
  background-image:url("https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=500&q=80");
}

/* =====================================================
   IMÁGENES DE CATEGORÍAS DE CURSOS
   ===================================================== */

.categoria-tecnologia{
  background-image:url("https://images.unsplash.com/photo-1461749280684-dccba630e2f6?auto=format&fit=crop&w=500&q=80");
}

.categoria-negocios{
  background-image:url("https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=500&q=80");
}

.categoria-desarrollo{
  background-image:url("https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=500&q=80");
}

.categoria-diseno{
  background-image:url("https://images.unsplash.com/photo-1561070791-2526d30994b5?auto=format&fit=crop&w=500&q=80");
}

.categoria-idiomas{
  background-image:url("https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?auto=format&fit=crop&w=500&q=80");
}

.categoria-otros{
  background-image:url("https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=500&q=80");
}

.empleos-seccion{
  margin-top:30px;
}

.empleos-cabecera{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  margin-bottom:13px;
}

.empleos-cabecera h2{
  margin:0;
  font-size:19px;
  color:#172033;
}

.contador-resultados{
  color:#64748b;
  font-size:11px;
}

.empleos-grid{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:17px;
  align-items:stretch;
}

.empleo-card{
  min-width:0;
  min-height:335px;
  height:100%;
  display:flex;
  flex-direction:column;
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:16px;
  overflow:hidden;
  box-shadow:0 4px 13px rgba(15,23,42,.07);
  transition:transform .2s,box-shadow .2s;
}

.empleo-card:hover{
  transform:translateY(-3px);
  box-shadow:0 10px 24px rgba(15,23,42,.12);
}

.empleo-visual{
  position:relative;
  height:75px;
  flex:0 0 75px;
  overflow:hidden;
  color:#fff;
}

.empleo-visual:after{
  content:"";
  position:absolute;
  width:100px;
  height:100px;
  right:-25px;
  top:-45px;
  border-radius:50%;
  border:18px solid rgba(255,255,255,.09);
}

.visual-ingenieria{
  background:linear-gradient(135deg,#125b91,#1976d2);
}

.visual-salud{
  background:linear-gradient(135deg,#087f8c,#12a4b4);
}

.visual-ventas-servicios{
  background:linear-gradient(135deg,#b45309,#f59e0b);
}

.visual-administracion-finanzas{
  background:linear-gradient(135deg,#6d28d9,#8b5cf6);
}

.visual-derecho{ background:linear-gradient(135deg,#9f1239,#e11d48); }

.visual-educacion{
  background:linear-gradient(135deg,#0f766e,#14b8a6);
}

.visual-otros{ background:linear-gradient(135deg,#6b7280,#9ca3af); }

/* =====================================================
   VISUALES DE BECAS POR TIPO
   ===================================================== */

.visual-universitaria{ background:linear-gradient(135deg,#125b91,#1976d2); }
.visual-no-universitaria{ background:linear-gradient(135deg,#4b5563,#6b7280); }
.visual-movilidad{ background:linear-gradient(135deg,#087f8c,#12a4b4); }
.visual-idiomas{ background:linear-gradient(135deg,#b45309,#f59e0b); }
.visual-investigacion{ background:linear-gradient(135deg,#6d28d9,#8b5cf6); }
.visual-excelencia{ background:linear-gradient(135deg,#854d0e,#ca8a04); }
.visual-sociales{ background:linear-gradient(135deg,#0f766e,#14b8a6); }
.visual-deportivas{ background:linear-gradient(135deg,#9f1239,#e11d48); }
.visual-beca-default{ background:linear-gradient(135deg,#6b7280,#9ca3af); }
.visual-otros{ background:linear-gradient(135deg,#6b7280,#9ca3af); }

/* =====================================================
   VISUALES PARA CURSOS
   ===================================================== */

.visual-tecnologia{ background:linear-gradient(135deg,#1e40af,#3b82f6); }
.visual-negocios{ background:linear-gradient(135deg,#4338ca,#818cf8); }
.visual-desarrollo{ background:linear-gradient(135deg,#0f766e,#2dd4bf); }
.visual-diseno{ background:linear-gradient(135deg,#9333ea,#c084fc); }
.visual-idiomas{ background:linear-gradient(135deg,#b45309,#f59e0b); }
.visual-curso-default{ background:linear-gradient(135deg,#6b7280,#9ca3af); }

/* =====================================================
   BADGE "VIGENTE" EN TARJETAS DE BECAS
   ===================================================== */

.beca-vigente{
  position:absolute;
  top:12px;
  right:12px;
  z-index:2;
  background:#0f4c81;
  color:#fff;
  font-size:10px;
  font-weight:800;
  letter-spacing:.5px;
  padding:4px 8px;
  border-radius:999px;
  box-shadow:0 2px 6px rgba(15,76,129,.4);
}

/* =====================================================
   TARJETA DE BECA CERRADA (atenuada)
   ===================================================== */

.beca-cerrada-card{
  border:2px solid #dc2626;
}

.beca-cerrada-card .empleo-boton{
  background:#dc2626 !important;
  pointer-events:auto !important;
  cursor:pointer !important;
}

.beca-cerrada-card .empleo-boton:hover{
  background:#b91c1c !important;
  transform:translateY(-1px) !important;
}

.empleo-etiqueta{
  position:absolute;
  left:10px;
  top:9px;
  z-index:3;
  padding:4px 7px;
  border-radius:5px;
  background:rgba(255,255,255,.17);
  border:1px solid rgba(255,255,255,.22);
  font-size:8px;
  font-weight:800;
  text-transform:uppercase;
}

.empleo-icono{
  position:absolute;
  right:13px;
  bottom:9px;
  z-index:3;
  width:39px;
  height:39px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  background:rgba(255,255,255,.15);
  border:1px solid rgba(255,255,255,.28);
  color:#fff;
}

.empleo-icono svg{
  width:21px;
  height:21px;
  display:block;
  stroke:currentColor;
  fill:none;
  stroke-width:1.8;
  stroke-linecap:round;
  stroke-linejoin:round;
}

.empleo-contenido{
  flex:1;
  display:flex;
  flex-direction:column;
  padding:13px 14px 14px;
  min-height:0;
}

.empleo-titulo{
  display:-webkit-box;
  -webkit-box-orient:vertical;
  -webkit-line-clamp:2;
  overflow:hidden;
  min-height:40px;
  margin:0 0 4px;
  color:#172033;
  font-size:16px;
  line-height:1.25;
  font-weight:800;
}

.empleo-card .empleo-empresa{
  min-height:13px;
  margin-bottom:9px;
  color:#64748b;
  font-size:11px;
  font-weight:600;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.empleo-datos{
  display:flex;
  flex-wrap:wrap;
  gap:5px;
  min-height:24px;
  max-height:48px;
  overflow:hidden;
  margin-bottom:9px;
}

.empleo-dato{
  padding:4px 6px;
  border-radius:5px;
  background:#f1f5f9;
  color:#475569;
  font-size:9px;
  line-height:1.2;
}

.empleo-salario{
  display:-webkit-box;
  -webkit-box-orient:vertical;
  -webkit-line-clamp:1;
  overflow:hidden;
  min-height:17px;
  margin-bottom:8px;
  color:#0f4c81;
  font-size:14px;
  font-weight:800;
}

.empleo-descripcion{
  display:-webkit-box;
  -webkit-box-orient:vertical;
  -webkit-line-clamp:2;
  overflow:hidden;
  height:27px;
  min-height:27px;
  margin-bottom:12px;
  color:#64748b;
  font-size:10px;
  line-height:1.35;
}

.empleo-pie{
  display:flex;
  flex-direction:column;
  align-items:flex-end;
  gap:7px;
  margin-top:auto;
}

.empleo-fecha{
  align-self:flex-start;
  min-height:13px;
  color:#94a3b8;
  font-size:11px;
}

.empleo-card .empleo-boton{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:34px;
  padding:0 16px;
  border-radius:7px;
  background:#1976d2;
  color:#fff !important;
  text-decoration:none !important;
  font-size:10px;
  font-weight:800;
  letter-spacing:.15px;
  white-space:nowrap;
}

.empleo-card .empleo-boton:hover{
  background:#0f4c81;
}

.empleo-cargando,
.empleo-vacio{
  grid-column:1/-1;
  padding:35px 20px;
  border:1px solid #e5e7eb;
  border-radius:16px;
  background:#fff;
  text-align:center;
  color:#64748b;
  font-size:13px;
}

.portal-lector{
  display:none;
}

@media(max-width:800px){

  .portal-empleos{
    padding:0 12px 35px;
  }

  .portal-header{
    height:55px;
  }

  .portal-logo{
    font-size:18px;
  }

  .portal-menu{
    display:none;
  }

  .buscador-empleos{
    padding:23px 14px 16px;
    border-radius:17px;
  }

  .buscador-empleos h1{
    font-size:23px;
  }

  .buscador-empleos p{
    font-size:12px;
    margin-bottom:15px;
  }

  .buscador-contenedor{
    display:flex;
    gap:7px;
  }

  .buscador-input{
    height:48px;
    font-size:12px;
    padding:0 12px;
  }

  .buscador-boton{
    height:48px;
    padding:0 13px;
    font-size:10px;
  }

  .filtros-contenedor{
    margin-top:9px;
  }

  .filtros-grid{
    gap:5px;
    justify-content:stretch;
  }

  .filtro-grupo{
    flex:1;
    min-width:0;
  }

  .filtro-grupo-titulo{
    height:32px;
    padding:0 20px 0 7px;
    font-size:8px;
  }

  .filtro-grupo-titulo .flecha{
    right:7px;
  }

  .filtro-opciones{
    min-width:130px;
    max-height:220px;
  }

  .filtro-opcion{
    font-size:10px;
  }

  .categorias-seccion{
    margin-top:24px;
  }

  .categorias-titulo h2,
  .empleos-cabecera h2{
    font-size:18px;
  }

  .categorias-controles{
    display:none;
  }

  .categorias-carrusel{
    gap:9px;
  }

  .categoria-card{
    flex-basis:125px;
    height:88px;
  }

  .empleos-seccion{
    margin-top:26px;
  }

  .empleos-grid{
    display:flex;
    gap:12px;
    overflow-x:auto;
    scrollbar-width:none;
    padding-bottom:4px;
    scroll-snap-type:x mandatory;
  }

  .empleos-grid::-webkit-scrollbar{
    display:none;
  }

  .empleo-card{
    flex:0 0 84%;
    height:335px;
    min-height:335px;
    scroll-snap-align:start;
  }

  .empleo-icono{
    width:38px;
    height:38px;
    right:12px;
    bottom:9px;
  }

  .empleo-icono svg{
    width:20px;
    height:20px;
  }

  .empleo-boton{
    width:100%;
    min-height:36px;
    font-size:10px;
  }
}

@media(max-width:380px){

  .empleo-card{
    flex-basis:91%;
  }

  .buscador-empleos h1{
    font-size:21px;
  }
}



.empleo-individual{
  width:100%;
  max-width:900px;
  margin:0 auto;
  padding:16px;
  box-sizing:border-box;
  font-family:Arial,Helvetica,sans-serif;
  color:#1f2937;
  line-height:1.6;
  animation:fadeInUp .5s ease-out;
}

@keyframes fadeInUp{
  from{ opacity:0; transform:translateY(20px); }
  to{ opacity:1; transform:translateY(0); }
}

.empleo-individual *{
  box-sizing:border-box;
}

.empleo-cabecera{
  background:linear-gradient(135deg,#0f4c81 0%,#1976d2 50%,#0d9488 100%);
  color:#fff;
  padding:32px 28px;
  border-radius:18px;
  box-shadow:0 8px 32px rgba(15,76,129,.25);
  margin-bottom:20px;
  position:relative;
  overflow:hidden;
}

.empleo-cabecera::before{
  content:"";
  position:absolute;
  top:-50%;
  right:-20%;
  width:300px;
  height:300px;
  background:radial-gradient(circle,rgba(255,255,255,.08) 0%,transparent 70%);
  border-radius:50%;
  pointer-events:none;
}

.empleo-cabecera::after{
  content:"";
  position:absolute;
  bottom:-30%;
  left:-10%;
  width:200px;
  height:200px;
  background:radial-gradient(circle,rgba(255,255,255,.05) 0%,transparent 70%);
  border-radius:50%;
  pointer-events:none;
}

.empleo-fuente{
  display:inline-flex;
  align-items:center;
  gap:6px;
  background:rgba(255,255,255,.18);
  border:1px solid rgba(255,255,255,.3);
  padding:6px 14px;
  border-radius:20px;
  font-size:12px;
  margin-bottom:12px;
  backdrop-filter:blur(4px);
}

.empleo-categoria{
  font-size:13px;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:1px;
  margin-bottom:8px;
  display:inline-flex;
  align-items:center;
  gap:6px;
}

.empleo-categoria::before{
  content:"";
  width:8px;
  height:8px;
  background:#fbbf24;
  border-radius:50%;
  display:inline-block;
}

.empleo-cabecera h1{
  margin:0 0 10px;
  font-size:32px;
  line-height:1.2;
  color:#fff;
  text-shadow:0 2px 4px rgba(0,0,0,.15);
  position:relative;
  z-index:1;
}

.empleo-cabecera .empleo-empresa{
  font-size:17px;
  font-weight:600;
  margin-bottom:6px;
  position:relative;
  z-index:1;
}

.empleo-salario-header{
  font-size:15px;
  opacity:.95;
  position:relative;
  z-index:1;
}

.empleo-info{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:14px;
  margin-bottom:20px;
}

.empleo-info-card{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:14px;
  padding:16px 14px;
  box-shadow:0 2px 10px rgba(0,0,0,.06);
  min-width:0;
  transition:transform .2s ease,box-shadow .2s ease;
  position:relative;
  overflow:hidden;
}

.empleo-info-card:hover{
  transform:translateY(-3px);
  box-shadow:0 6px 20px rgba(0,0,0,.1);
}

.empleo-info-card::before{
  content:"";
  position:absolute;
  top:0;
  left:0;
  right:0;
  height:3px;
  background:linear-gradient(90deg,#0f4c81,#1976d2);
  border-radius:14px 14px 0 0;
}

.empleo-info-label{
  font-size:11px;
  color:#6b7280;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.5px;
  margin-bottom:5px;
}

.empleo-info-value{
  font-size:15px;
  color:#1f2937;
  font-weight:700;
  overflow-wrap:anywhere;
}

.empleo-seccion{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:16px;
  padding:24px;
  margin-bottom:18px;
  box-shadow:0 2px 10px rgba(0,0,0,.05);
  transition:box-shadow .2s ease;
}

.empleo-seccion:hover{
  box-shadow:0 4px 16px rgba(0,0,0,.08);
}

.empleo-seccion h2{
  margin:0 0 16px;
  padding-bottom:12px;
  border-bottom:2px solid #e5e7eb;
  color:#0f4c81;
  font-size:21px;
  line-height:1.3;
  display:flex;
  align-items:center;
  gap:10px;
}

.empleo-seccion p{
  margin:0 0 12px;
  font-size:15px;
}

.empleo-seccion ul{
  margin:10px 0 0;
  padding-left:0;
  list-style:none;
}

.empleo-seccion li{
  margin-bottom:10px;
  padding-left:24px;
  position:relative;
  font-size:15px;
}

.empleo-seccion li::before{
  content:"";
  position:absolute;
  left:0;
  top:8px;
  width:8px;
  height:8px;
  background:linear-gradient(135deg,#0f4c81,#1976d2);
  border-radius:50%;
}

.empleo-destacado{
  background:linear-gradient(135deg,#eff6ff,#f0f9ff);
  border-left:4px solid #1976d2;
  border-radius:10px;
  padding:16px 18px;
  margin-top:12px;
}

.empleo-destacado p{
  margin:0 0 8px;
  font-size:15px;
}

.empleo-destacado p:last-child{
  margin-bottom:0;
}

.empleo-anuncio{
  min-height:90px;
  border:1px dashed #d1d5db;
  border-radius:14px;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  color:#9ca3af;
  font-size:12px;
  margin:16px 0;
}

/* ══════════════════════════════════════════════
   ESTILOS MEJORADOS PARA ENTRADAS INDIVIDUALES
   ══════════════════════════════════════════════ */

.empleo-individual{
  font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
  line-height:1.75;
}

.empleo-individual p{
  font-size:16px;
  color:#374151;
  margin-bottom:16px;
}

.empleo-individual strong{
  color:#0f4c81;
}

/* ── TÍTULO PRINCIPAL (h2 fuera de .empleo-seccion) ── */
.empleo-individual > h2{
  margin:0 0 20px;
  padding:0;
}

.empleo-individual > h2 > strong{
  background:linear-gradient(135deg,#0f4c81,#1976d2);
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
  background-clip:text;
  font-size:28px;
  line-height:1.3;
  display:block;
}

.empleo-seccion h2{
  font-size:23px;
  border-bottom:3px solid #e5e7eb;
  padding-bottom:14px;
  margin-bottom:20px;
}

.empleo-seccion p{
  font-size:16px;
  color:#374151;
  line-height:1.75;
}

.empleo-seccion li{
  font-size:16px;
  line-height:1.65;
  color:#374151;
}

.empleo-seccion ul li::before{
  width:10px;
  height:10px;
  box-shadow:0 0 0 3px rgba(25,118,210,.12);
}

.empleo-seccion ol li::before{
  width:24px;
  height:24px;
  font-size:13px;
}

.empleo-cabecera h1{
  font-size:36px;
}

.empleo-info-card{
  border-radius:16px;
  padding:20px 14px;
  text-align:center;
}

.empleo-info-card:nth-child(1)::before{ background:linear-gradient(90deg,#0f4c81,#1976d2); }
.empleo-info-card:nth-child(2)::before{ background:linear-gradient(90deg,#0d9488,#2dd4bf); }
.empleo-info-card:nth-child(3)::before{ background:linear-gradient(90deg,#b45309,#f59e0b); }
.empleo-info-card:nth-child(4)::before{ background:linear-gradient(90deg,#6d28d9,#8b5cf6); }

.empleo-destacado{
  border-left-width:5px;
  border-radius:12px;
  padding:20px 22px;
  background:linear-gradient(135deg,#eff6ff,#f0f9ff);
}

/* ── BARRA DE PROGRESO ── */
.empleo-progreso-bar{
  position:fixed;
  top:0;
  left:0;
  height:4px;
  background:linear-gradient(90deg,#0f4c81,#1976d2,#0d9488);
  z-index:99999;
  transition:width .1s linear;
  pointer-events:none;
}

/* ── SECCIONES CON COLORES ALTERNOS ── */
.empleo-seccion:nth-child(even){
  background:#fafbfc;
}

/* ── FAQ: cajas individuales con inline styles ── */
/* FAQ boxes use inline styles (background, border, border-radius) */
/* This rule only targets legacy single-container FAQ format */

/* ── MEJOR ESPACIADO GENERAL ── */
.empleo-individual .empleo-seccion + .empleo-seccion{
  margin-top:22px;

}

.empleo-postular{
  background:linear-gradient(135deg,#eff6ff,#f8fbff);
  border:1px solid #bfdbfe;
  border-radius:15px;
  padding:24px 20px;
  text-align:center;
  margin-bottom:16px;
}

.empleo-postular h2{
  color:#0f4c81;
  margin:0 0 9px;
  font-size:21px;
}

.empleo-postular .empleo-boton{
  display:inline-block;
  background:#1976d2;
  color:#fff!important;
  text-decoration:none!important;
  padding:13px 25px;
  border-radius:9px;
  font-size:15px;
  font-weight:700;
  margin-top:7px;
  transition:.2s;
}

.empleo-postular .empleo-boton:hover{
  background:#0f4c81;
}

.empleo-aviso{
  color:#6b7280;
  font-size:12px;
  margin-top:10px;
}

.ofertas-relacionadas{
  margin-top:20px;
}

.ofertas-relacionadas h2{
  color:#0f4c81;
  font-size:22px;
  margin:0 0 14px;
}

.relacionados-grid{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:14px;
}

.relacionado-card{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:15px;
  overflow:hidden;
  box-shadow:0 3px 10px rgba(0,0,0,.06);
  transition:transform .2s,box-shadow .2s;
  display:flex;
  flex-direction:column;
}

.relacionado-card:hover{
  transform:translateY(-2px);
  box-shadow:0 6px 15px rgba(0,0,0,.1);
}

.relacionado-visual{
  height:75px;
  padding:10px 13px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  color:#fff;
}

.relacionado-etiqueta{
  background:rgba(255,255,255,.18);
  border:1px solid rgba(255,255,255,.25);
  border-radius:20px;
  padding:4px 9px;
  font-size:10px;
  font-weight:700;
}

.relacionado-icono{
  width:39px;
  height:39px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  background:rgba(255,255,255,.15);
  border:1px solid rgba(255,255,255,.28);
  color:#fff;
  flex:0 0 39px;
}

.relacionado-icono svg{
  width:21px;
  height:21px;
  display:block;
  stroke:currentColor;
  fill:none;
  stroke-width:1.8;
  stroke-linecap:round;
  stroke-linejoin:round;
}

.relacionado-contenido{
  padding:13px 14px 14px;
  display:flex;
  flex-direction:column;
  flex:1;
}

.relacionado-titulo{
  color:#1f2937;
  font-size:16px;
  line-height:1.3;
  font-weight:700;
  margin-bottom:5px;
  display:-webkit-box;
  -webkit-line-clamp:2;
  -webkit-box-orient:vertical;
  overflow:hidden;
}

.relacionado-empresa{
  color:#6b7280;
  font-size:11px;
  margin-bottom:8px;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.relacionado-datos{
  display:flex;
  flex-wrap:wrap;
  gap:5px;
  margin-bottom:8px;
}

.relacionado-chip{
  background:#f3f4f6;
  color:#4b5563;
  border-radius:12px;
  padding:3px 7px;
  font-size:9px;
  font-weight:600;
}

.relacionado-salario{
  color:#1976d2;
  font-size:14px;
  font-weight:700;
  margin-bottom:5px;
}

.relacionado-descripcion{
  color:#6b7280;
  font-size:10px;
  line-height:1.4;
  display:-webkit-box;
  -webkit-line-clamp:2;
  -webkit-box-orient:vertical;
  overflow:hidden;
  margin-bottom:7px;
}

.relacionado-fecha{
  color:#9ca3af;
  font-size:11px;
  margin-bottom:8px;
}

.relacionado-boton{
  display:flex;
  align-items:center;
  justify-content:center;
  width:100%;
  min-height:32px;
  margin-top:auto;
  background:#1976d2;
  color:#fff!important;
  text-decoration:none!important;
  border-radius:7px;
  font-size:11px;
  font-weight:700;
}

.relacionado-boton:hover{
  background:#0f4c81;
}

.visual-ingenieria{
  background:linear-gradient(135deg,#125b91,#1976d2);
}

.visual-salud{
  background:linear-gradient(135deg,#087f8c,#12a4b4);
}

.visual-ventas-servicios{
  background:linear-gradient(135deg,#b45309,#f59e0b);
}

.visual-administracion-finanzas{
  background:linear-gradient(135deg,#6d28d9,#8b5cf6);
}

.visual-derecho{ background:linear-gradient(135deg,#9f1239,#e11d48); }

.visual-educacion{
  background:linear-gradient(135deg,#0f766e,#14b8a6);
}

.visual-otros{ background:linear-gradient(135deg,#6b7280,#9ca3af); }

@media(max-width:700px){

  .empleo-individual{
    padding:10px;
  }

  .empleo-cabecera{
    padding:24px 18px;
    border-radius:14px;
  }

  .empleo-cabecera h1{
    font-size:24px;
  }

  .empleo-empresa{
    font-size:15px;
  }

  .empleo-info{
    grid-template-columns:repeat(2,1fr);
    gap:9px;
  }

  .empleo-info-card{
    padding:13px 10px;
  }

  .empleo-info-value{
    font-size:13px;
  }

  .empleo-seccion{
    padding:18px 16px;
  }

  .empleo-seccion h2{
    font-size:18px;
  }

  .empleo-anuncio{
    min-height:70px;
  }

  .empleo-boton{
    width:100%;
  }

  .relacionados-grid{
    display:flex;
    overflow-x:auto;
    gap:12px;
    padding-bottom:5px;
    scroll-snap-type:x mandatory;
  }

  .relacionado-card{
    flex:0 0 84%;
    scroll-snap-align:start;
  }
}

@media(max-width:380px){

  .relacionado-card{
    flex-basis:91%;
  }
}


  /* =====================================================
     SOBRESCRITURA PARA PUBLICACIONES ANTIGUAS
     Los posts viejos llevan su propio CSS incrustado con
     los colores anteriores. Estas reglas con !important
     ganan y uniformizan TODAS las tarjetas sin tocar
     cada publicación.
     ===================================================== */

  .visual-derecho{
    background:linear-gradient(135deg,#9f1239,#e11d48) !important;
  }

.visual-otros{
    background:linear-gradient(135deg,#6b7280,#9ca3af) !important;
  }

  /* =====================================================
     SECCI“N DE ARTÍCULOS (tarjetas "LEER")
     ===================================================== */

  .portal-titulo-seccion{
    margin:26px 0 6px;
    padding:22px 20px;
    background:linear-gradient(135deg,#0f4c81,#1976d2);
    border-radius:16px;
    color:#fff;
  }

  .portal-titulo-seccion h1{
    margin:0 0 6px;
    font-size:24px;
    line-height:1.2;
  }

  .portal-titulo-seccion p{
    margin:0;
    font-size:14px;
    opacity:.92;
  }

  .articulo-card{
    display:flex;
    flex-direction:column;
    gap:8px;
    background:#ffffff;
    border:1px solid #e5e7eb;
    border-radius:14px;
    padding:18px;
    color:#111827;
    text-decoration:none;
    box-shadow:0 1px 3px rgba(0,0,0,.05);
    transition:transform .15s ease,box-shadow .15s ease;
  }

  .articulo-card:hover{
    transform:translateY(-2px);
    box-shadow:0 6px 16px rgba(15,76,129,.12);
  }

  .articulo-categoria{
    align-self:flex-start;
    background:#eef6ff;
    color:#1976d2;
    font-size:11px;
    font-weight:700;
    letter-spacing:.4px;
    padding:3px 10px;
    border-radius:20px;
  }

  .articulo-titulo{
    margin:0;
    font-size:17px;
    font-weight:800;
    line-height:1.3;
  }

  .articulo-resumen{
    margin:0;
    font-size:13px;
    color:#6b7280;
    line-height:1.5;
    display:-webkit-box;
    -webkit-line-clamp:3;
    -webkit-box-orient:vertical;
    overflow:hidden;
  }

  .articulo-meta{
    margin-top:auto;
    display:flex;
    align-items:center;
    justify-content:space-between;
    font-size:12px;
    color:#9ca3af;
  }

  .articulo-leer{
    color:#1976d2;
    font-weight:700;
    font-size:12px;
  }

  .portal-empleos .articulos-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(300px,1fr));
    gap:16px;
  }

  @media(max-width:640px){
    .portal-empleos .articulos-grid{
      grid-template-columns:1fr;
    }
  }
  /* =====================================================
     HUB DE INICIO (tarjetas EMPLEOS / BECAS / ARTÍCULOS)
     ===================================================== */

  .hub-hero{
    margin:26px 0 6px;
    padding:30px 20px;
    background:linear-gradient(135deg,#0f4c81,#1976d2);
    border-radius:16px;
    color:#fff;
    text-align:center;
  }

  .hub-hero h1{
    margin:0 0 8px;
    font-size:28px;
    line-height:1.2;
  }

  .hub-hero p{
    margin:0 auto;
    max-width:560px;
    font-size:15px;
    opacity:.92;
  }

  .hub-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
    gap:18px;
    margin:34px 0 8px;
  }

  @media(min-width:860px){
    .hub-grid{
      grid-template-columns:repeat(3,1fr);
    }
  }

  .hub-card{
    display:flex;
    flex-direction:column;
    gap:12px;
    padding:0 0 22px;
    border-radius:16px;
    background:#ffffff;
    border:1px solid #e5e7eb;
    color:#111827;
    text-decoration:none;
    overflow:hidden;
    box-shadow:0 1px 3px rgba(0,0,0,.05);
    transition:transform .15s ease,box-shadow .15s ease;
  }

  .hub-card:hover{
    transform:translateY(-3px);
    box-shadow:0 8px 20px rgba(15,76,129,.14);
  }

  .hub-imagen{
    position:relative;
    height:120px;
    display:flex;
    align-items:center;
    justify-content:center;
    overflow:hidden;
  }

  .hub-imagen::before,
  .hub-imagen::after{
    content:"";
    position:absolute;
    border-radius:50%;
    background:rgba(255,255,255,.18);
  }

  .hub-imagen::before{
    width:150px;
    height:150px;
    top:-55px;
    right:-40px;
  }

  .hub-imagen::after{
    width:110px;
    height:110px;
    bottom:-45px;
    left:-35px;
  }

  .hub-imagen svg{
    position:relative;
    width:58px;
    height:58px;
    fill:none;
    stroke:#fff;
    stroke-width:1.8;
    stroke-linecap:round;
    stroke-linejoin:round;
    filter:drop-shadow(0 4px 8px rgba(0,0,0,.25));
  }

  .hub-card-empleos .hub-imagen{
    background:linear-gradient(135deg,#0f4c81,#1976d2);
  }

  .hub-card-becas .hub-imagen{
    background:linear-gradient(135deg,#b45309,#f59e0b);
  }

  .hub-card-articulos .hub-imagen{
    background:linear-gradient(135deg,#5b21b6,#8b5cf6);
  }

  .hub-card h2{ color:#0f4c81; margin:0; padding:0 22px; font-size:20px; font-weight:800; letter-spacing:.5px; color:#0f4c81; }

  .hub-card p{
    margin:0;
    padding:0 22px;
    font-size:14px;
    color:#6b7280;
    line-height:1.55;
  }

  .hub-boton{
    margin:auto 22px 0;
    padding:10px 16px;
    border-radius:9px;
    background:#0f4c81;
    color:#fff;
    font-size:12px;
    font-weight:800;
    letter-spacing:.5px;
    text-align:center;
  }

  .hub-card-articulos .hub-boton{ background:#0f4c81; }
  }

  @media(max-width:640px){
    .hub-hero h1{
      font-size:22px;
    }
  }

  /* =====================================================
     GADGET DE NAVEGACI“N FLOTANTE (Inicio/Empleos/Becas/Artículos)
     Se muestra como barra inferior fija en páginas y entradas
     ===================================================== */

  .portal-navport{
    position:fixed;
    left:50%;
    bottom:14px;
    transform:translateX(-50%);
    z-index:9999;
    display:flex;
    align-items:center;
    gap:2px;
    padding:5px;
    border-radius:18px;
    background:rgba(15,76,129,.94);
    box-shadow:0 8px 24px rgba(15,76,129,.35);
    backdrop-filter:blur(6px);
    max-width:calc(100% - 16px);
  }

  .portal-navport a{
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:2px;
    min-width:0;
    flex:1 1 0;
    padding:6px 4px;
    border-radius:12px;
    color:#cfe3f7;
    text-decoration:none;
    font-size:9px;
    font-weight:700;
    letter-spacing:.2px;
    white-space:nowrap;
  }

  .portal-navport a svg{
    width:20px;
    height:20px;
    fill:none;
    stroke:currentColor;
    stroke-width:2;
    stroke-linecap:round;
    stroke-linejoin:round;
  }

  .portal-navport a.activo{
    background:#ffffff;
    color:#0f4c81;
  }

  body.portal-con-navport{
    padding-bottom:74px;
  }

  /* =====================================================
     MIGAS DE PAN (breadcrumbs) - SEO y orientación
     ===================================================== */

  .portal-migas{
    margin:18px 0 0;
    font-size:12px;
    color:#6b7280;
  }

  .portal-migas ol{
    margin:0;
    padding:0;
    list-style:none;
    display:flex;
    flex-wrap:wrap;
    gap:6px;
    align-items:center;
  }

  .portal-migas li{
    display:flex;
    align-items:center;
    gap:6px;
  }

  .portal-migas li + li::before{
    content:"›";
    color:#9ca3af;
  }

  .portal-migas a{
    color:#1976d2;
    text-decoration:none;
  }

  .portal-migas a:hover{
    text-decoration:underline;
  }

  .portal-migas .actual{
    color:#374151;
    font-weight:600;
  }

  /* =====================================================
     BOTONES DE COMPARTIR (tráfico y alcance)
     ===================================================== */

  .portal-compartir{
    margin:18px 0 4px;
  }

  .portal-compartir-titulo{
    font-size:12px;
    font-weight:700;
    color:#6b7280;
    margin:0 0 8px;
  }

  .portal-compartir-botones{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
  }

  .portal-compartir-boton{
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:8px 12px;
    border-radius:9px;
    border:0;
    cursor:pointer;
    color:#fff;
    font-size:12px;
    font-weight:700;
    text-decoration:none;
    transition:opacity .15s ease;
  }

  .portal-compartir-boton:hover{
    opacity:.88;
  }

  .portal-compartir-boton svg{
    width:15px;
    height:15px;
    fill:none;
    stroke:currentColor;
    stroke-width:2;
    stroke-linecap:round;
    stroke-linejoin:round;
  }

  .portal-c-whatsapp{ background:#25d366; }
  .portal-c-facebook{ background:#1877f2; }
  .portal-c-x{ background:#111827; }
  .portal-c-linkedin{ background:#0a66c2; }
  .portal-c-copiar{ background:#6b7280; }

  /* =====================================================
     BOTONES FLOTANTES (WhatsApp + volver arriba)
     ===================================================== */

  .portal-flotantes{
    position:fixed;
    right:14px;
    bottom:86px;
    z-index:9998;
    display:flex;
    flex-direction:column;
    gap:10px;
  }

  .portal-fab{
    width:46px;
    height:46px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    color:#fff;
    text-decoration:none;
    border:0;
    cursor:pointer;
    box-shadow:0 4px 14px rgba(0,0,0,.22);
    transition:transform .15s ease;
  }

  .portal-fab:hover{
    transform:scale(1.08);
  }

  .portal-fab svg{
    width:22px;
    height:22px;
    fill:none;
    stroke:currentColor;
    stroke-width:2;
    stroke-linecap:round;
    stroke-linejoin:round;
  }

  .portal-fab-whatsapp{
    background:#25d366;
  }

  .portal-fab-subir{
    background:#0f4c81;
    opacity:0;
    pointer-events:none;
    transform:translateY(8px);
  }

  .portal-fab-subir.visible{
    opacity:1;
    pointer-events:auto;
    transform:translateY(0);
  }

  /* =====================================================
     INSIGNIA "NUEVO" en tarjetas de empleo
     ===================================================== */

  .empleo-nuevo{
    position:absolute;
    top:12px;
    right:12px;
    z-index:2;
    background:#16a34a;
    color:#fff;
    font-size:10px;
    font-weight:800;
    letter-spacing:.5px;
    padding:4px 8px;
    border-radius:999px;
    box-shadow:0 2px 6px rgba(22,163,74,.4);
  }

  /* =====================================================
     TAGS EN TARJETAS DE BECAS
     ===================================================== */

  .empleo-tags{
    display:flex;
    flex-wrap:wrap;
    gap:5px;
    margin-top:6px;
  }

   .empleo-tag{
     display:inline-block;
     padding:3px 7px;
     border-radius:5px;
     background:#e0e7ff;
     color:#3730a3;
     font-size:10px;
     font-weight:700;
     line-height:1.2;
   }

   .empleo-fechas-card{
     display:flex;
     flex-direction:column;
     gap:3px;
     margin-top:10px;
     padding-top:10px;
     border-top:1px solid #e5e7eb;
   }

   .empleo-fechas-card span{
     display:block;
     font-size:11px;
     color:#6b7280;
     font-weight:600;
   }

   .empleo-boton{
     margin-top:auto;
     padding-top:14px;
   }

  /* =====================================================
     INSIGNIA DE SEGUIMIENTO (fecha de caducidad)
     ===================================================== */

  .empleo-cierre{
    position:absolute;
    top:12px;
    right:12px;
    z-index:2;
    color:#fff;
    font-size:10px;
    font-weight:800;
    letter-spacing:.5px;
    padding:4px 8px;
    border-radius:999px;
  }

  .empleo-cierre-pronto{
    background:#d97706;
    box-shadow:0 2px 6px rgba(217,119,6,.4);
  }

  .empleo-cierre-urgente{
    background:#dc2626;
    box-shadow:0 2px 6px rgba(220,38,38,.4);
    animation:pulsoUrgente 1.5s ease-in-out infinite;
  }

  .empleo-cierre-cerrada{
    background:#dc2626;
    box-shadow:0 2px 8px rgba(220,38,38,.5);
    font-size:11px;
    padding:5px 12px;
    letter-spacing:1px;
  }

  .empleo-nuevo + .empleo-cierre,
  .empleo-cierre + .empleo-nuevo{
    top:auto;
    right:12px;
  }

  @keyframes pulsoUrgente{
    0%,100%{ opacity:1; }
    50%{ opacity:.7; }
  }

  .empleo-visual{
    position:relative;
  }

  /* =====================================================
     FRANJA DE ESTADÍSTICAS (confianza)
     ===================================================== */

  .portal-stats{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(120px,1fr));
    gap:12px;
    margin:20px 0 4px;
  }

  .portal-stats-item{
    background:#fff;
    border:1px solid #e5e7eb;
    border-radius:14px;
    padding:14px 12px;
    text-align:center;
  }

  .portal-stats-numero{
    font-size:22px;
    font-weight:800;
    color:#0f4c81;
    line-height:1.1;
  }

  .portal-stats-etiqueta{
    font-size:11px;
    color:#6b7280;
    font-weight:600;
    margin-top:4px;
  }

  /* =====================================================
     BOT“N "CARGAR MÁS OFERTAS"
     ===================================================== */

  .cargar-mas-contenedor{
    text-align:center;
    margin:22px 0 6px;
  }

  .cargar-mas-boton{
    background:#0f4c81;
    color:#fff;
    border:0;
    padding:12px 26px;
    border-radius:10px;
    font-size:13px;
    font-weight:800;
    letter-spacing:.4px;
    cursor:pointer;
    transition:opacity .15s ease,transform .15s ease;
  }

  .cargar-mas-boton:hover{
    opacity:.9;
    transform:translateY(-1px);
  }

  .cargar-mas-boton:disabled{
    opacity:.5;
    cursor:default;
    transform:none;
  }

  .cargar-mas-estado{
    font-size:12px;
    color:#6b7280;
    margin-top:8px;
  }

  /* =====================================================
     PIE DE PÁGINA
     ===================================================== */

  .portal-footer{
    margin-top:38px;
    padding:26px 0 18px;
    border-top:1px solid #e5e7eb;
    background:#f8fafc;
    border-radius:0 0 0 0;
  }

  .portal-footer-contenido{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
    gap:18px;
  }

  .portal-footer h3{
    font-size:13px;
    font-weight:800;
    color:#0f4c81;
    margin:0 0 10px;
  }

  .portal-footer a{
    display:block;
    color:#374151;
    text-decoration:none;
    font-size:13px;
    padding:3px 0;
  }

  .portal-footer a:hover{
    color:#1976d2;
    text-decoration:underline;
  }

  .portal-footer-legal{
    margin-top:18px;
    padding-top:14px;
    border-top:1px solid #e5e7eb;
    font-size:11px;
    color:#9ca3af;
    line-height:1.5;
  }

  /* =====================================================
     ENTRADA ANIMACI“N TARJETAS
     ===================================================== */

  @keyframes portalEntradaTarjeta{
    from{ opacity:0; transform:translateY(8px); }
    to{ opacity:1; transform:translateY(0); }
  }

  .empleo-card{
    animation:portalEntradaTarjeta .25s ease both;
  }
  /* =====================================================
     PÁGINAS DE TEXTO (Políticas y Términos)
     ===================================================== */

  .pagina-contenido{
    margin:22px 0 6px;
    background:#fff;
    border:1px solid #e5e7eb;
    border-radius:16px;
    padding:24px 24px 18px;
    color:#374151;
    line-height:1.7;
    font-size:15px;
  }

  .pagina-contenido h2{
    font-size:17px;
    color:#0f4c81;
    margin:24px 0 8px;
  }

  .pagina-contenido h2:first-child{
    margin-top:0;
  }

  .pagina-contenido p{
    margin:0 0 12px;
  }

  .pagina-contenido ul{
    margin:0 0 14px;
    padding-left:20px;
  }

  .pagina-contenido li{
    margin-bottom:6px;
  }

  .pagina-contenido a{
    color:#1976d2;
  }

  .pagina-fecha{
    margin-top:22px;
    padding-top:14px;
    border-top:1px solid #e5e7eb;
    font-size:12px;
    color:#9ca3af;
  }

  @media(max-width:640px){
    .pagina-contenido{
      padding:18px 16px;
    }
  }
  /* =====================================================
     GADGET "PÁGINAS" DE BLOGGER EN UNA FILA
     (el listado vertical del pie del tema pasa a fila)
     ===================================================== */

  .widget.PageList .widget-content > ul,
  .widget.LinkList .widget-content > ul,
  .widget.PageList ul,
  .gadget .PageList ul{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    align-items:center;
    gap:6px 18px;
    list-style:none;
    margin:0;
    padding:0;
  }

  .widget.PageList ul li,
  .widget.LinkList ul li{
    display:inline-block;
    margin:0;
    padding:0;
  }

  .widget.PageList ul li a,
  .widget.LinkList ul li a{
    display:inline-block;
    padding:6px 8px;
    text-decoration:none;
    font-weight:600;
  }

  /* =====================================================
     OCULTAR LA CABECERA-PORTADA DEL TEMA (montañas)
     El portal ya trae su propia cabecera (.portal-header),
     de modo que la cabecera de Contempo solo sobra.
     ===================================================== */

  .widget.Header,
  #Header1,
  .header-image-wrapper,
  .cover,
  .cover-image,
  #header,
  .header-section{
    background-image:none !important;
  }

  .widget.Header img,
  #Header1 img,
  .header-image,
  .cover-image,
  .cover img{
    display:none !important;
    visibility:hidden !important;
  }

  .widget.Header,
  #Header1,
  .header-image-wrapper,
  .cover{
    background:transparent !important;
    min-height:0;
  }

  /* =====================================================
     PORTADA: imagen propia visible, texto oscuro con
     sombra blanca (legible sobre fondo claro).
     ===================================================== */

  .bg-photo,
  [class*="bg-photo"],
  [class*="bgPhoto"]{
    background-image:
      linear-gradient(rgba(255,255,255,.35),rgba(255,255,255,.35)),
      url("https://blogger.googleusercontent.com/img/a/AVvXsEgp3fAzMbd-8qE1p320hJy0UA9icBNHux76F-TRfKL_UvtWwvyBjVsWUZNJsVI-7u4G1IpSA7M6-DrEl1kqbzWMcI8DbSqezpiZ7WJxqcLDuyn_sL4JED848jo11gOKHM9PJNTiZqbDGPx-koqbuh1d8aZCToTBGRmrAQaZiLCKF7LIDSOXhtYki-Jnb-GC=s1600") !important;
    background-size:cover !important;
    background-position:center !important;
    background-repeat:no-repeat !important;
    min-height:320px;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
  }

  .bg-photo img,
  [class*="bg-photo"] img{
    display:none !important;
    visibility:hidden !important;
  }

  .header-widget{
    color:#0f4c81 !important;
    max-width:760px;
    margin:0 auto;
    padding:20px;
  }

  .header-widget h1{
    margin:0 0 10px;
  }

  .header-widget h1 a{
    color:#0f4c81 !important;
    text-shadow:0 2px 8px rgba(255,255,255,.9),0 0 20px rgba(255,255,255,.7);
    text-decoration:none;
    letter-spacing:1px;
    font-weight:800;
  }

  .header-widget p{
    color:#1f3d5c !important;
    text-shadow:0 2px 6px rgba(255,255,255,.9),0 0 16px rgba(255,255,255,.7);
    margin:0;
    font-weight:700;
    font-size:16px;
  }

  .header-widget a{
    color:inherit !important;
    text-decoration:none;
  }

  @media(max-width:640px){
    /* En celular la foto se adapta al ancho: alto por aspecto
       (16:9) y posición centrada para que se vea completa */
    .bg-photo,
    [class*="bg-photo"],
    [class*="bgPhoto"]{
      min-height:0;
      aspect-ratio:4/3;
      background-position:center top !important;
    }
    .header-widget{
      padding:14px;
    }
    .header-widget h1 a{
      font-size:22px;
    }
    .header-widget p{
      font-size:13px;
    }
  }

  /* Elemento detectado con Inspeccionar: bg-photo container */
  /* FONDO: imagen propia de la propietaria, tamaño completo */
  .bg-photo,
  [class*="bg-photo"],
  [class*="bgPhoto"]{
    background-image:url("https://blogger.googleusercontent.com/img/a/AVvXsEgp3fAzMbd-8qE1p320hJy0UA9icBNHux76F-TRfKL_UvtWwvyBjVsWUZNJsVI-7u4G1IpSA7M6-DrEl1kqbzWMcI8DbSqezpiZ7WJxqcLDuyn_sL4JED848jo11gOKHM9PJNTiZqbDGPx-koqbuh1d8aZCToTBGRmrAQaZiLCKF7LIDSOXhtYki-Jnb-GC=s1600") !important;
    background-size:cover !important;
    background-position:center !important;
    background-repeat:no-repeat !important;
    min-height:280px;
  }

  .bg-photo img,
  [class*="bg-photo"] img{
    display:none !important;
    visibility:hidden !important;
  }

  /* =====================================================
     CRONOGRAMA DE BECAS (plantilla completa)
     ===================================================== */

  .empleo-cronograma{
    display:grid;
    grid-template-columns:1fr;
    gap:0;
    margin:6px 0 4px;
  }

  .empleo-crono-item{
    position:relative;
    padding:14px 14px 14px 46px;
    border-left:3px solid #1d9bf0;
    border-bottom:1px solid #e5e7eb;
    border-radius:0;
  }

  .empleo-crono-item:last-child{
    border-bottom:none;
  }

  .empleo-crono-fase{
    position:absolute;
    left:8px;
    top:14px;
    width:26px;
    height:26px;
    border-radius:50%;
    background:#0f4c81;
    color:#fff;
    font-size:12px;
    font-weight:700;
    display:flex;
    align-items:center;
    justify-content:center;
  }

  .empleo-crono-nombre{
    font-weight:700;
    color:#111827;
    font-size:15px;
    margin-bottom:2px;
  }

  .empleo-crono-fecha{
    font-size:13px;
    color:#4b5563;
  }

  .empleo-boton-secundario{
    background:#374151 !important;
    margin:6px 0 4px;
  }

  .empleo-boton-secundario:hover{
    background:#1f2937 !important;
  }

  /*]]>*/
</style>

<script>
//<![CDATA[

(function(){
  function _cuandoListo(){
    if(document.readyState === "loading"){
      document.addEventListener("DOMContentLoaded", _cuandoListo);
      return;
    }

/* =========================================================
       PORTAL DE INICIO (solo si existe #empleosGrid)
       ========================================================= */
    (function(){
      "use strict";
      try {

/* =========================================================
   CONFIGURACI“N DEL PORTAL
   Cambia estas dos líneas con tus datos reales:
   - whatsapp: tu número con código de país SIN el signo +
     (ejemplo "51950123456" para Perú)
   - correoContacto: el correo para recibir mensajes
   ========================================================= */
window.PORTAL_CONFIG = {
  whatsapp: "",
  correoContacto: "empleosperuhoy@gmail.com",
  nombreSitio: "EMPLEOS PERš HOY",
  dominio: "https://empleosperuhoy.blogspot.com"
};

var FEED_URL =
"https://empleosperuhoy.blogspot.com/feeds/posts/default/-/Empleo?alt=json-in-script&max-results=50&orderby=published&callback=empleosPeruHoyCallback";

var empleos = [];
var categoriaActiva = "Todos";

var filtrosAplicados = {
  modalidad:[],
  experiencia:[],
  ciudad:[],
  salario:[]
};

var busquedaActual = "";

function normalizar(texto){

  return String(texto || "")
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g,"")
    .replace(/\s+/g," ")
    .trim();

}

function textoElemento(elemento){

  if(!elemento){
    return "";
  }

  return String(
    elemento.textContent ||
    elemento.innerText ||
    ""
  ).trim();

}

function limpiarTexto(texto){

  return String(texto || "")
    .replace(/\s+/g," ")
    .trim();

}

function escaparHTML(texto){

  return String(texto || "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#39;");

}

function obtenerUrlEntrada(entry){

  if(!entry){
    return "";
  }

  if(entry.link){

    for(var i=0;i<entry.link.length;i++){

      if(entry.link[i].rel === "alternate"){
        return entry.link[i].href || "";
      }

    }

  }

  return "";

}

function obtenerInfo(entry){

  if(!entry || !entry.content){
    return "";
  }

  return String(entry.content.$t || "");

}

function obtenerSeccion(entry){

  if(!entry || !entry.category){
    return "";
  }

  for(var i=0;i<entry.category.length;i++){

    var categoria =
      entry.category[i].term || "";

    if(normalizar(categoria) !== "empleo"){
      return categoria;
    }

  }

  return "";

}

/* =========================================================
   EXTRACCI“N ROBUSTA DE CAMPOS
   ========================================================= */

function obtenerCampoOferta(html,nombres){

  var contenedor =
    document.createElement("div");

  contenedor.innerHTML =
    html || "";

  var nombresNormalizados =
    nombres.map(normalizar);

  var elementos =
    contenedor.querySelectorAll(
      "p,li,div,td,tr,strong,b,span"
    );

  for(var i=0;i<elementos.length;i++){

    var elemento =
      elementos[i];

    var texto =
      limpiarTexto(
        textoElemento(elemento)
      );

    if(
      !texto ||
      texto.length > 500
    ){
      continue;
    }

    var normal =
      normalizar(texto);

    for(var j=0;j<nombresNormalizados.length;j++){

      var nombre =
        nombresNormalizados[j];

      if(normal === nombre){

        var siguiente =
          elemento.nextElementSibling;

        if(siguiente){

          var valorSiguiente =
            limpiarTexto(
              textoElemento(siguiente)
            );

          if(
            valorSiguiente &&
            normalizar(valorSiguiente) !== nombre
          ){

            return valorSiguiente;

          }

        }

        var padre =
          elemento.parentElement;

        if(padre){

          var textoPadre =
            limpiarTexto(
              textoElemento(padre)
            );

          if(
            textoPadre.length > texto.length
          ){

            var resto =
              limpiarTexto(
                textoPadre
                  .replace(
                    new RegExp(
                      "^" + nombre + "\\s*[:\\-]?\\s*",
                      "i"
                    ),
                    ""
                  )
              );

            if(
              resto &&
              normalizar(resto) !== nombre
            ){

              return resto;

            }

          }

        }

      }

      if(
        normal.indexOf(
          nombre + ":"
        ) === 0
      ){

        var posicion =
          texto.indexOf(":");

        if(posicion !== -1){

          var valor =
            limpiarTexto(
              texto.substring(
                posicion + 1
              )
            );

          if(valor){
            return valor;
          }

        }

      }

      if(
        normal.indexOf(
          nombre + " -"
        ) === 0
      ){

        var posicionGuion =
          texto.indexOf("-");

        if(posicionGuion !== -1){

          var valorGuion =
            limpiarTexto(
              texto.substring(
                posicionGuion + 1
              )
            );

          if(valorGuion){
            return valorGuion;
          }

        }

      }

    }

  }

  var textoCompleto =
    limpiarTexto(
      contenedor.textContent ||
      ""
    );

  var lineas =
    textoCompleto
      .split(/\n+/)
      .map(limpiarTexto)
      .filter(Boolean);

  for(var k=0;k<lineas.length;k++){

    var linea =
      lineas[k];

    var lineaNormal =
      normalizar(linea);

    for(var z=0;z<nombresNormalizados.length;z++){

      var nombreSalario =
        nombresNormalizados[z];

      if(
        lineaNormal.indexOf(
          nombreSalario
        ) === 0
      ){

        var resultado =
          linea.replace(
            new RegExp(
              "^\\s*" +
              nombreSalario +
              "\\s*[:\\-]?\\s*",
              "i"
            ),
            ""
          );

        resultado =
          limpiarTexto(resultado);

        if(
          resultado &&
          normalizar(resultado) !==
          nombreSalario
        ){

          return resultado;

        }

        if(lineas[k+1]){

          return limpiarTexto(
            lineas[k+1]
          );

        }

      }

    }

  }

  return "";

}

function obtenerDescripcion(html){

  var contenedor =
    document.createElement("div");

  contenedor.innerHTML =
    html || "";

  var candidatos =
    contenedor.querySelectorAll(
      ".empleo-descripcion,p"
    );

  var textos = [];

  for(var i=0;i<candidatos.length;i++){

    var texto =
      limpiarTexto(
        textoElemento(candidatos[i])
      );

    var normal =
      normalizar(texto);

    if(
      texto.length > 60 &&
      normal.indexOf(
        "fecha de publicacion"
      ) !== 0 &&
      normal.indexOf(
        "fecha de cierre"
      ) !== 0 &&
      normal.indexOf(
        "vacantes:"
      ) !== 0
    ){

      textos.push(texto);

    }

  }

  if(textos.length){
    return textos.slice(0,3).join(" ");
  }

  return "Oportunidad laboral disponible en Empleos Perú Hoy.";

}

/* =========================================================
   CATEGORIZACI“N INTELIGENTE
   ========================================================= */

function contieneCualquiera(texto,palabras){

  var t =
    normalizar(texto);

  for(var i=0;i<palabras.length;i++){

    if(
      t.indexOf(
        normalizar(palabras[i])
      ) !== -1
    ){

      return true;

    }

  }

  return false;

}

