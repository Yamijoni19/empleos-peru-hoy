icos inconclusos\u003c/li\u003e\n    \u003cli\u003eExperiencia en limpieza y mantenimientos de oficinas\u003c/li\u003e\n    \u003cli\u003eorganizacion y trabajo en equipo.\u003c/li\u003e\n    \u003cli\u003eDisponibilidad para laborar en Chorrillos\u003c/li\u003e\n    \u003cli\u003eDisponibilidad para laborar en el horario de lunes a viernes\u003c/li\u003e\n  \u003c/ul\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-anuncio\"\u003e\n  Espacio publicitario\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n\n  \u003ch2\u003eInformación de la oferta\u003c/h2\u003e\n\n  \u003cdiv class=\"empleo-destacado\"\u003e\n\n\n\n\n\n\n\n    \u003cp\u003e\u003cstrong\u003eSalario:\u003c/strong\u003e No especificado\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eFecha publicación:\u003c/strong\u003e 30/09/2026\u003c/p\u003e\r\n\r\n    \u003cp\u003e\u003cstrong\u003eFecha cierre:\u003c/strong\u003e 20/10/2026\u003c/p\u003e\r\n\r\n    \u003cp\u003e\u003cstrong\u003eTipo contratante:\u003c/strong\u003e Privado\u003c/p\u003e\r\n\r\n    \u003cp\u003e\u003cstrong\u003eTipo de contrato Estado:\u003c/strong\u003e No aplica\u003c/p\u003e\r\n\r\n    \u003cp\u003e\u003cstrong\u003eTipo de entidad:\u003c/strong\u003e No aplica\u003c/p\u003e\r\n\r\n  \u003c/div\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n\n  \u003ch2\u003eBeneficios\u003c/h2\u003e\n\n  \u003cul\u003e\n    \u003cli\u003eConsulta los beneficios y condiciones en la publicación original del portal.\u003c/li\u003e\n  \u003c/ul\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-anuncio\"\u003e\n  Espacio publicitario\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n\n  \u003ch2\u003eInformación de la empresa\u003c/h2\u003e\n\n  \u003cdiv class=\"empleo-destacado\"\u003e\n\n\n\n\n\n    \u003cp\u003e\n      \u003cstrong\u003eDescripción:\u003c/strong\u003e\n      No especificado\n    \u003c/p\u003e\n\n  \u003c/div\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class