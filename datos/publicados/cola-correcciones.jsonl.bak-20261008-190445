;\n  font-size:10px;\n  line-height:1.4;\n  display:-webkit-box;\n  -webkit-line-clamp:2;\n  -webkit-box-orient:vertical;\n  overflow:hidden;\n  margin-bottom:7px;\n}\n\n.relacionado-fecha{\n  color:#9ca3af;\n  font-size:11px;\n  margin-bottom:8px;\n}\n\n.relacionado-boton{\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  width:100%;\n  min-height:32px;\n  margin-top:auto;\n  background:#1976d2;\n  color:#fff!important;\n  text-decoration:none!important;\n  border-radius:7px;\n  font-size:11px;\n  font-weight:700;\n}\n\n.relacionado-boton:hover{\n  background:#0f4c81;\n}\n\n.visual-ingenieria{\n  background:linear-gradient(135deg,#125b91,#1976d2);\n}\n\n.visual-salud{\n  background:linear-gradient(135deg,#087f8c,#12a4b4);\n}\n\n.visual-ventas-servicios{\n  background:linear-gradient(135deg,#b45309,#f59e0b);\n}\n\n.visual-administracion-finanzas{\n  background:linear-gradient(135deg,#6d28d9,#8b5cf6);\n}\n\n.visual-derecho{\n  background:linear-gradient(135deg,#334155,#64748b);\n}\n\n.visual-educacion{\n  background:linear-gradient(135deg,#0f766e,#14b8a6);\n}\n\n.visual-otros{\n  background:linear-gradient(135deg,#475569,#64748b);\n}\n\n@media(max-width:700px){\n\n  .empleo-individual{\n    padding:10px;\n  }\n\n  .empleo-cabecera{\n    padding:24px 18px;\n    border-radius:14px;\n  }\n\n  .empleo-cabecera h1{\n    font-size:24px;\n  }\n\n  .empleo-empresa{\n    font-size:15px;\n  }\n\n  .empleo-info{\n    grid-template-columns:repeat(2,1fr);\n    gap:9px;\n  }\n\n  .empleo-info-card{\n    padding:13px 10px;\n  }\n\n  .empleo-info-value{\n    font-size:13px;\n  }\n\n  .empleo-seccion{\n    padding:18px 16px;\n  }\n\n  .empleo-seccion h2{\n    font-size:18px;\n  }\n\n  .empleo-anuncio{\n    min-height:70px;\n  }\n\n  .empleo-boton{\n    width:100%;\n  }\n\n  .relacionados-grid{\n    display:flex;\n    overflow-x:auto;\n    gap:12px;\n    padding-bottom:5px;\n    scroll-snap-type:x mandatory;\n  }\n\n  .relacionado-card{\n    flex:0 0 84%;\n    scroll-snap-align:start;\n  }\n}\n\n@media(max-width:380px){\n\n  .relacionado-card{\n    flex-basis:91%;\n  }\n}\n\u003c/style\u003e\n\n\n\u003cdiv class=\"empleo-cabecera\"\u003e\n\n  \u003cdiv class=\"empleo-fuente\"\u003eFuente: Bumeran\u003c/div\u003e\n\n  \u003cdiv class=\"empleo-categoria\"\u003eAdministración y Finanzas\u003c/div\u003e\n\n  \u003ch1\u003eAdministrador\u003c/h1\u003e\n\n  \u003cdiv class=\"empleo-empresa\"\u003eCORPORACION MINERA LOS ZARCOS ULLOA E.I.R.L\u003c/div\u003e\n\n  \u003cdiv class=\"empleo-salario-header\"\u003e\n    S/ 3,000\u003c/div\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-info\"\u003e\n\n  \u003cdiv class=\"empleo-info-card\"\u003e\n    \u003cdiv class=\"empleo-info-label\"\u003eUbicación\u003c/div\u003e\n    \u003cdiv class=\"empleo-info-value\"\u003eTrujillo, La Libertad, Peru\u003c/div\u003e\n  \u003c/div\u003e\n\n  \u003cdiv class=\"empleo-info-card\"\u003e\n    \u003cdiv class=\"empleo-info-label\"\u003eModalidad\u003c/div\u003e\n    \u003cdiv class=\"empleo-info-value\"\u003ePresencial\u003c/div\u003e\n  \u003c/div\u003e\n\n  \u003cdiv class=\"empleo-info-card\"\u003e\n    \u003cdiv class=\"empleo-info-label\"\u003eContrato\u003c/div\u003e\n    \u003cdiv class=\"empleo-info-value\"\u003eNo especificado\u003c/div\u003e\n  \u003c/div\u003e\n\n  \u003cdiv class=\"empleo-info-card\"\u003e\n    \u003cdiv class=\"empleo-info-label\"\u003eSalario\u003c/div\u003e\n    \u003cdiv class=\"empleo-info-value\"\u003eDe S/.3,000 A S/.4,000 Por Mes\u003c/div\u003e\n  \u003c/div\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-anuncio\"\u003e\n  Espacio publicitario\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n\n  \u003ch2\u003eDescripción del puesto\u003c/h2\u003e\n\n  \u003cp\u003e\n    Buscamos un profesional con título en Administración para unirse a nuestro equipo. El candidato ideal poseerá una sólida experiencia y habilidades de gestión para supervisar diversas áreas operativas.\n  \u003c/p\u003e\n\n  \u003cp\u003e\n    El puesto requiere experiencia en procesos logísticos, compras e inventarios, gestión de recursos humanos, control presupuestario, análisis de flujos de caja y gestión de tesorería, así como el cumplimiento de normativas y políticas internas.\n  \u003c/p\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-anuncio\"\u003e\n  Espacio publicitario\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n\n  \u003ch2\u003eFunciones\u003c/h2\u003e\n\n  \u003cul\u003e\n    \u003cli\u003eSupervisar procesos logísticos, compras e inventarios.\u003c/li\u003e\n    \u003cli\u003eGestionar recursos humanos.\u003c/li\u003e\n    \u003cli\u003eRealizar control presupuestario, análisis de flujos de caja y gestión de tesorería.\u003c/li\u003e\n    \u003cli\u003eAsegurar el cumplimiento de normativas y políticas internas.\u003c/li\u003e\n    \u003cli\u003eColaborar en la definición y seguimiento de presupuestos y costos.\u003c/li\u003e\n    \u003cli\u003eNo especificado\u003c/li\u003e\n  \u003c/ul\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n\n  \u003ch2\u003eRequisitos\u003c/h2\u003e\n\n  \u003cul\u003e\n    \u003cli\u003eTítulo profesional en Administración o campo afín.\u003c/li\u003e\n    \u003cli\u003eColegiatura vigente.\u003c/li\u003e\n    \u003cli\u003eMás de 5 años de experiencia profesional.\u003c/li\u003e\n    \u003cli\u003eEspecialización, diplomado o maestría en áreas relevantes.\u003c/li\u003e\n    \u003cli\u003eDominio avanzado de Microsoft Office, con énfasis en Excel (financiero, tableros de control, costos y presupuestos).\u003c/li\u003e\n  \u003c/ul\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-anuncio\"\u003e\n  Espacio publicitario\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n\n  \u003ch2\u003eInformación de la oferta\u003c/h2\u003e\n\n  \u003cdiv class=\"empleo-destacado\"\u003e\n\n    \u003cp\u003e\u003cstrong\u003eVacantes:\u003c/strong\u003e 1 vacante disponible\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eJornada:\u003c/strong\u003e Full-time\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eContrato:\u003c/strong\u003e No especificado\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eModalidad:\u003c/strong\u003e Presencial\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eExperiencia:\u003c/strong\u003e Más de 5 años de experiencia profesional\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eEstudios:\u003c/strong\u003e Título profesional en Administración o campo afín\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eSalario:\u003c/strong\u003e S/ 3,000\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eFecha publicación:\u003c/strong\u003e 01/09/2026\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eFecha cierre:\u003c/strong\u003e No especificada en la publicación\u003c/p\u003e\n    \n    \u003cp\u003e\u003cstrong\u003eTipo contratante:\u003c/strong\u003e Privado\u003c/p\u003e\n\n\n  \u003c/div\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n\n  \u003ch2\u003eBeneficios\u003c/h2\u003e\n\n  \u003cul\u003e\n    \u003cli\u003eNo especificado\u003c/li\u003e\n    \u003cli\u003eNo especificado\u003c/li\u003e\n    \u003cli\u003eNo especificado\u003c/li\u003e\n    \u003cli\u003eNo especificado\u003c/li\u003e\n  \u003c/ul\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-anuncio\"\u003e\n  Espacio publicitario\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n\n  \u003ch2\u003eInformación de la empresa\u003c/h2\u003e\n\n  \u003cdiv class=\"empleo-destacado\"\u003e\n\n    \u003cp\u003e\u003cstrong\u003eEmpresa:\u003c/strong\u003e CORPORACION MINERA LOS ZARCOS ULLOA E.I.R.L\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eSector:\u003c/strong\u003e Minería\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eTamaño:\u003c/strong\u003e No especificado en la publicación\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eUbicación:\u003c/strong\u003e No especificada en la publicación\u003c/p\u003e\n\n    \u003cp\u003e\n      \u003cstrong\u003eDescripción:\u003c/strong\u003e\n      No especificada en la publicación\n    \u003c/p\u003e\n\n  \u003c/div\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-anuncio\"\u003e\n  Espacio publicitario\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-postular\"\u003e\n\n  \u003ch2\u003e¿Te interesa esta oferta?\u003c/h2\u003e\n\n  \u003ca\n    class=\"empleo-boton\"\n    href=\"https://www.bumeran.com.pe/empleos/administrador-corporacion-minera-los-zarcos-ulloa-e.i.r.l-1118421369.html\"\n    target=\"_blank\"\n    rel=\"noopener noreferrer\"\n  \u003e\n    POSTULAR EN BUMERAN\n  \u003c/a\u003e\n\n  \u003cdiv class=\"empleo-aviso\"\u003e\n    La postulación se realiza directamente en la plataforma de origen.\n  \u003c/div\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"ofertas-relacionadas\"\u003e\n\n  \u003ch2\u003eOfertas recomendadas para ti\u003c/h2\u003e\n\n  \u003cdiv id=\"ofertasRelacionadas\" class=\"relacionados-grid\"\u003e\u003c/div\u003e\n\n\u003c/div\u003e\n\n\n\u003cscript\u003e\n(function(){\n\n  \"use strict\";\n\n  var CONTENEDOR_ID = \"ofertasRelacionadas\";\n\n  function normalizarTexto(texto){\n\n    return String(texto || \"\")\n      .replace(/\\u00a0/g,\" \")\n      .replace(/\\s+/g,\" \")\n      .trim();\n\n  }\n\n  function escaparHTML(texto){\n\n    return String(texto || \"\")\n      .replace(/\u0026/g,\"\u0026amp;\")\n      .replace(/\u003c/g,\"\u0026lt;\")\n      .replace(/\u003e/g,\"\u0026gt;\")\n      .replace(/\"/g,\"\u0026quot;\")\n      .replace(/\u0027/g,\"\u0026#39;\");\n\n  }\n\n  function escaparAtributo(texto){\n\n    return escaparHTML(texto);\n\n  }\n\n  function limpiarHTMLParaLectura(html){\n\n    var contenedor = document.createElement(\"div\");\n\n    contenedor.innerHTML = html || \"\";\n\n    var elementosEliminar = contenedor.querySelectorAll(\n      \"script,style,noscript,template,iframe,object,embed\"\n    );\n\n    for(var i=0;i\u003c