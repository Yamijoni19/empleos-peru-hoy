ral - Puno\u003c/h1\u003e\n\n  \u003cdiv class=\"empleo-empresa\"\u003eELECTRO PUNO\u003c/div\u003e\n\n  \u003cdiv class=\"empleo-salario-header\"\u003e\n    No especificado\u003c/div\u003e\n\n\u003c/div\u003e\n\n\u003cp class=\"empleo-vigencia\"\u003eCONVOCATORIA VIGENTE. Revisa el cronograma para conocer las fechas de cada etapa del proceso.\u003c/p\u003e\n\n\u003cdiv class=\"empleo-info\"\u003e\n\n  \u003cdiv class=\"empleo-info-card\"\u003e\n    \u003cdiv class=\"empleo-info-label\"\u003eVacantes\u003c/div\u003e\n    \u003cdiv class=\"empleo-info-value\"\u003e1\u003c/div\u003e\n  \u003c/div\u003e\n\n  \u003cdiv class=\"empleo-info-card\"\u003e\n    \u003cdiv class=\"empleo-info-label\"\u003eContrato\u003c/div\u003e\n    \u003cdiv class=\"empleo-info-value\"\u003ePr cticas\u003c/div\u003e\n  \u003c/div\u003e\n\n  \u003cdiv class=\"empleo-info-card\"\u003e\n    \u003cdiv class=\"empleo-info-label\"\u003eDirigido a\u003c/div\u003e\n    \u003cdiv class=\"empleo-info-value\"\u003eEgresados de la carrera t cnica de Administraci n, Secretariado Ejecutivo o egresado y/o bachiller de las especialidades de Administraci n y/o Derecho\u003c/div\u003e\n  \u003c/div\u003e\n\n  \u003cdiv class=\"empleo-info-card\"\u003e\n    \u003cdiv class=\"empleo-info-label\"\u003eUbicaci n\u003c/div\u003e\n    \u003cdiv class=\"empleo-info-value\"\u003ePuno, Puno, Per \u003c/div\u003e\n  \u003c/div\u003e\n\n\u003c/div\u003e\n\n\u003cdiv class=\"empleo-anuncio\"\u003e\n  Espacio publicitario\n\u003c/div\u003e\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n  \u003ch2\u003eRequisitos\u003c/h2\u003e\n  \u003cp\u003e\n    Egresados de la carrera t cnica de Administraci n, Secretariado Ejecutivo o egresado y/o bachiller de las especialidades de Administraci n y/o Derecho\n  \u003c/p\u003e\n  \u003cdiv class=\"empleo-destacado\"\u003e\n    \u003cp\u003e\u003cstrong\u003eVacantes:\u003c/strong\u003e 1\u003c/p\u003e\n    \u003cp\u003e\u003cstrong\u003eDirigido a:\u003c/strong\u003e Egresados de la carrera t cnica de Administraci n, Secretariado Ejecutivo o egresado y/o bachiller de las especialidades de Administraci n y/o Derecho\u003c/p\u003e\n    \u003cp\u003e\u003cstrong\u003eEstudios:\u003c/strong\u003e Egresados de la carrera t cnica de Administraci n, Secretariado Ejecutivo o egresado y/o bachiller de las especialidades de Administraci n y/o Derecho\u003c/p\u003e\n  \u003c/div\u003e\n  \u003cp\u003e\u003cstrong\u003eActividad a realizar:\u003c/strong\u003e\u003c/p\u003e\n  \u003cul\u003e\n    \u003cli\u003eApoyo en las actividades administrativas de la Secretaria de la Gerencia General.\u003c/li\u003e\n    \u003cli\u003eApoyo en la recepci n, registros, organizaci n, derivaci n y seguimiento de documentos mediante el sistema de gesti n documentaria (cero papeles).\u003c/li\u003e\n    \u003cli\u003eApoyo en la elaboraci n, revisi n y redacci n de documentos administrativos.\u003c/li\u003e\n    \u003cli\u003eApoyo en la generaci n y seguimiento de pedidos a trav s del sistema SAP.\u003c/li\u003e\n    \u003cli\u003eApoyo en la generaci n y gesti n de requerimiento mediante el sistema SIELSE, relacionado con papeletas vehiculares y vi ticos.\u003c/li\u003e\n    \u003cli\u003eApoyo en el manejo y seguimiento de informaci n en las plataformas institucionales del MINEM Y FONAFE.\u003c/li\u003e\n  \u003c/ul\u003e\n\u003c/div\u003e\n\n\u003cdiv class=\"empleo-anuncio\"\u003e\n  Espacio publicitario\n\u003c/div\u003e\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n  \u003ch2\u003eCondiciones del contrato\u003c/h2\u003e\n  \u003cdiv class=\"empleo-destacado\"\u003e\n    \u003cp\u003e\u003cstrong\u003eEntidad:\u003c/strong\u003e ELECTRO PUNO\u003c/p\u003e\n    \u003cp\u003e\u003cstrong\u003eUbicaci n:\u003c/strong\u003e Puno, Puno, Per \u003c/p\u003e\n    \u003cp\u003e\u003cstrong\u003eModalidad:\u003c/strong\u003e Profesional\u003c/p\u003e\n    \u003cp\u003e\u003cstrong\u003eFecha de cierre:\u003c/strong\u003e 29/09/2026\u003c/p\u003e\n  \u003c/div\u003e\n\u003c/div\u0