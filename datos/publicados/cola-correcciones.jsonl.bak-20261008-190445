mpleo-anuncio{\n    min-height:70px;\n  }\n\n  .empleo-boton{\n    width:100%;\n  }\n\n  .relacionados-grid{\n    display:flex;\n    overflow-x:auto;\n    gap:12px;\n    padding-bottom:5px;\n    scroll-snap-type:x mandatory;\n  }\n\n  .relacionado-card{\n    flex:0 0 84%;\n    scroll-snap-align:start;\n  }\n}\n\n@media(max-width:380px){\n\n  .relacionado-card{\n    flex-basis:91%;\n  }\n}\n\u003c/style\u003e\n\n\n\u003cdiv class=\"empleo-cabecera\"\u003e\n\n  \u003cdiv class=\"empleo-fuente\"\u003eFuente: COMPUTRABAJO\u003c/div\u003e\n\n  \u003cdiv class=\"empleo-categoria\"\u003eAdministración y Finanzas\u003c/div\u003e\n\n  \u003ch1\u003eAsistente de Gestión Docente\u003c/h1\u003e\n\n  \u003cdiv class=\"empleo-empresa\"\u003eIngenium\u003c/div\u003e\n\n  \u003cdiv class=\"empleo-salario-header\"\u003e\n    S/ 1.200,00\u003c/div\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-info\"\u003e\n\n  \u003cdiv class=\"empleo-info-card\"\u003e\n    \u003cdiv class=\"empleo-info-label\"\u003eUbicación\u003c/div\u003e\n    \u003cdiv class=\"empleo-info-value\"\u003eCayma, Arequipa, Perú\u003c/div\u003e\n  \u003c/div\u003e\n\n  \u003cdiv class=\"empleo-info-card\"\u003e\n    \u003cdiv class=\"empleo-info-label\"\u003eModalidad\u003c/div\u003e\n    \u003cdiv class=\"empleo-info-value\"\u003ePresencial y remoto\u003c/div\u003e\n  \u003c/div\u003e\n\n  \u003cdiv class=\"empleo-info-card\"\u003e\n    \u003cdiv class=\"empleo-info-label\"\u003eContrato\u003c/div\u003e\n    \u003cdiv class=\"empleo-info-value\"\u003eContrato por Necesidades del Mercado\u003c/div\u003e\n  \u003c/div\u003e\n\n  \u003cdiv class=\"empleo-info-card\"\u003e\n    \u003cdiv class=\"empleo-info-label\"\u003eSalario\u003c/div\u003e\n    \u003cdiv class=\"empleo-info-value\"\u003eS/. 1.200,00 (Mensual)\u003c/div\u003e\n  \u003c/div\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-anuncio\"\u003e\n  Espacio publicitario\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n\n  \u003ch2\u003eDescripción del puesto\u003c/h2\u003e\n\n  \u003cp\u003e\n    En Ingenium | Escuela de Formación Profesional, creemos en el talento, la actitud y el potencial de las personas. Por eso, invitamos a profesionales con perfil administrativo, académico, organizado y orientado a resultados a formar parte de una empresa que promueve la estabilidad, el reconocimiento, el crecimiento personal y el desarrollo laboral.\n  \u003c/p\u003e\n\n  \u003cp\u003e\n    Somos la empresa de educación online con mayor crecimiento del Perú. Hemos transformado la vida de más de 100,000 alumnos en Perú, Colombia, México y Ecuador, y seguimos expandiéndonos con el propósito de brindar educación de calidad y generar oportunidades reales de desarrollo. Este 2026 cumplimos 7 años de trayectoria, habiendo crecido más de 60 veces gracias a un equipo comprometido con la excelencia, la innovación y el impacto en la educación.\n  \u003c/p\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-anuncio\"\u003e\n  Espacio publicitario\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n\n  \u003ch2\u003eFunciones\u003c/h2\u003e\n\n  \u003cul\u003e\n    \u003cli\u003eBuscar y seleccionar docentes según el perfil definido por Innovación y Desarrollo de Programas.\u003c/li\u003e\n    \u003cli\u003eCoordinar la entrega de evaluaciones y materiales por parte del docente.\u003c/li\u003e\n    \u003cli\u003eConfirmar disponibilidad docente y gestionar la firma de contratos.\u003c/li\u003e\n    \u003cli\u003eGestionar reprogramaciones y relanzamientos.\u003c/li\u003e\n    \u003cli\u003eMonitorear cronogramas, sesiones, reprogramaciones y cancelaciones.\u003c/li\u003e\n    \u003cli\u003eEnviar recordatorios sobre el inicio de módulos y obtener confirmación de los docentes.\u003c/li\u003e\n  \u003c/ul\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n\n  \u003ch2\u003eRequisitos\u003c/h2\u003e\n\n  \u003cul\u003e\n    \u003cli\u003eEstudiante, egresado, bachiller o titulado en Administración, Ciencias de la Comunicación, Ingeniería Industrial, Ingeniería Comercial o carreras afines.\u003c/li\u003e\n    \u003cli\u003eExperiencia mínima de 6 meses en puestos similares o experiencia general relacionada.\u003c/li\u003e\n    \u003cli\u003eConocimiento en gestión curricular y control de cumplimiento académico.\u003c/li\u003e\n    \u003cli\u003eConocimiento en gestión documental.\u003c/li\u003e\n    \u003cli\u003eConocimiento en gestión de proyectos y control de cronogramas.\u003c/li\u003e\n  \u003c/ul\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-anuncio\"\u003e\n  Espacio publicitario\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n\n  \u003ch2\u003eInformación de la oferta\u003c/h2\u003e\n\n  \u003cdiv class=\"empleo-destacado\"\u003e\n\n    \u003cp\u003e\u003cstrong\u003eVacantes:\u003c/strong\u003e No especificado\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eJornada:\u003c/strong\u003e Tiempo completo\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eContrato:\u003c/strong\u003e Contrato por Necesidades del Mercado\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eModalidad:\u003c/strong\u003e Presencial y remoto\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eExperiencia:\u003c/strong\u003e Mínimo 6 meses en puestos similares o experiencia general relacionada\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eEstudios:\u003c/strong\u003e Educación mínima: Técnico. Estudiante, egresado, bachiller o titulado en Administración, Ciencias de la Comunicación, Ingeniería Industrial, Ingeniería Comercial o carreras afines\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eSalario:\u003c/strong\u003e S/ 1.200,00\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eFecha publicación:\u003c/strong\u003e No especificada en la publicación\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eFecha cierre:\u003c/strong\u003e No especificada en la publicación\u003c/p\u003e\n    \n    \u003cp\u003e\u003cstrong\u003eTipo contratante:\u003c/strong\u003e Privado\u003c/p\u003e\n\n\n  \u003c/div\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n\n  \u003ch2\u003eBeneficios\u003c/h2\u003e\n\n  \u003cul\u003e\n    \u003cli\u003eLínea de carrera dentro de la organización.\u003c/li\u003e\n    \u003cli\u003eFormación continua y acompañamiento en procesos internos.\u003c/li\u003e\n    \u003cli\u003eExcelente clima laboral y participación en actividades institucionales.\u003c/li\u003e\n    \u003cli\u003eOportunidad de desarrollarte en una empresa educativa en constante crecimiento. Pertenecer a una organización certificada y orientada a la mejora continua.\u003c/li\u003e\n  \u003c/ul\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-anuncio\"\u003e\n  Espacio publicitario\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n\n  \u003ch2\u003eInformación de la empresa\u003c/h2\u003e\n\n  \u003cdiv class=\"empleo-destacado\"\u003e\n\n    \u003cp\u003e\u003cstrong\u003eEmpresa:\u003c/strong\u003e Ingenium\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eSector:\u003c/strong\u003e Educación\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eTamaño:\u003c/strong\u003e No especificado en la publicación\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eUbicación:\u003c/strong\u003e Arequipa, Perú\u003c/p\u003e\n\n    \u003cp\u003e\n      \u003cstrong\u003eDescripción:\u003c/strong\u003e\n      Somos Ingenium | Escuela de Formación Profesional, la empresa de educación online con el mayor crecimiento del mercado en los últimos dos años, tenemos la gran misión de cambiar el mundo con la educación y queremos que seas parte de nuestro equipo.\n    \u003c/p\u003e\n\n  \u003c/div\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-anuncio\"\u003e\n  Espacio publicitario\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-postular\"\u003e\n\n  \u003ch2\u003e¿Te interesa esta oferta?\u003c/h2\u003e\n\n  \u003ca\n    class=\"empleo-boton\"\n    href=\"https://pe.computrabajo.com/trabajo-de-profesor?sal=2#65FCC34CC1244E3461373E686DCF3405\"\n    target=\"_blank\"\n    rel=\"noopener noreferrer\"\n  \u003e\n    POSTULAR EN COMPUTRABAJO\n  \u003c/a\u003e\n\n  \u003cdiv class=\"empleo-aviso\"\u003e\n    La postulación se realiza directamente en la plataforma de origen.\n  \u003c/div\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"ofertas-relacionadas\"\u003e\n\n  \u003ch2\u003eOfertas recomendadas para ti\u003c/h2\u003e\n\n  \u003cdiv id=\"ofertasRelacionadas\" class=\"relacionados-grid\"\u003e\u003c/div\u003e\n\n\u003c/div\u003e\n\n\n\u003cscript\u003e\n(function(){\n\n  \"use strict\";\n\n  var CONTENEDOR_ID = \"ofertasRelacionadas\";\n\n  function normalizarTexto(texto){\n\n    return String(texto || \"\")\n      .replace(/\\u00a0/g,\" \")\n      .replace(/\\s+/g,\" \")\n      .trim();\n\n  }\n\n  function escaparHTML(texto){\n\n    return String(texto || \"\")\n      .replace(/\u0026/g,\"\u0026amp;\")\n      .replace(/\u003c/g,\"\u0026lt;\")\n      .replace(/\u003e/g,\"\u0026gt;\")\n      .replace(/\"/g,\"\u0026quot;\")\n      .replace(/\u0027/g,\"\u0026#39;\");\n\n  }\n\n  function escaparAtributo(texto){\n\n    return escaparHTML(texto);\n\n  }\n\n  function limpiarHTMLParaLectura(html){\n\n    var contenedor = document.createElement(\"div\");\n\n    contenedor.innerHTML = html || \"\";\n\n    var elementosEliminar = contenedor.querySelectorAll(\n      \"script,style,noscript,template,iframe,object,embed\"\n    );\n\n    for(var i=0;i\u003celementosEliminar.length;i++){\n      elementosEliminar[i].remove();\n    }\n\n    return contenedor;\n\n  }\n\n  function textoNodo(nodo){\n\n    if(!nodo){\n      return \"\";\n    }\n\n    return normalizarTexto(\n      nodo.textContent ||\n      nodo.innerText ||\n      \"\"\n    );\n\n  }\n\n  function obtenerTextoPagina(selector){\n\n    var nodo = document.querySelector(selector);\n\n    return nodo ? textoNodo(nodo) : \"\";\n\n  }\n\n  function obtenerCiudadPagina(){\n\n    var tarjetas = document.querySelectorAll(\".empleo-info-card\");\n\n    for(var i=0;i\u003ctarjetas.length;i++){\n\n      var etiqueta = tarjetas[i].querySelector(\".empleo-info-label\");\n\n      if(!etiqueta){\n        continue;\n      }\n\n      if(\n        textoNodo(etiqueta).toLowerCase() ===\n        \"ubicación\".toLowerCase()\n      ){\n\n        var valor = tarjetas[i].querySelector(\".empleo-info-value\");\n\n        if(valor){\n\n          var texto = textoNodo(valor);\n\n          return texto.split(\",\")[0].trim() || \"\";\n\n        }\n\n      }\n\n    }\n\n    return \"\";\n\n  }\n\n  var TITULO_ACTUAL =\n    obtenerTextoPagina(\".empleo-cabecera h1\") ||\n    (document.title || \"\");\n\n  var URL_ACTUAL =\n    window.location.href || \"\";\n\n  var CATEGORIA_ACTUAL =\n    obtenerTextoPagina(\".empleo-cabecera .empleo-categoria\");\n\n  var EMPRESA_ACTUAL =\n    obtenerTextoPagina(\".empleo-cabecera .empleo-empresa\");\n\n  var CIUDAD_ACTUAL =\n    obtenerCiudadPagina();\n\n  function normalizarCategoria(categoria){\n\n    var texto = normalizarTexto(categoria).toLowerCase();\n\n    if(\n      /abogad|derecho|legal|juridic|asesor legal|asesor juridic|asesoria legal|contratos|compliance|notar|procurador/.test(texto)\n    ){\n      return \"Derecho\";\n    }\n\n    if(\n      /medic|enfermer|odontolog|farmaci|fisioter|nutri|psicolog|obstetr|clinic|hospital|salud/.test(texto)\n    ){\n      return \"Salud\";\n    }\n\n    if(\n      /ingenier|arquitect|urbanismo|operaciones|produccion|mantenimiento|procesos|logistic|almacen|supply chain|cadena de suministro|distribucion|transporte|ssoma|sst|hse|ehs|seguridad ocupacional|medio ambiente|prevencion de riesgos|mecanico|electricista|industrial|civil|calidad|mineria/.test(texto)\n    ){\n      return \"Ingeniería\";\n    }\n\n    if(\n      /ventas|venta|vendedor|asesor comercial|ejecutivo comercial|representante comercial|promotor|comercial|televentas|call center|atencion al cliente|atencion al usuario|servicio al cliente|cobranzas|ejecutivo de cuenta|retail|tienda|restaurante|hotel/.test(texto)\n    ){\n      return \"Ventas y Servicios\";\n    }\n\n    if(\n      /administrad|administracion|asistente administrativ|auxiliar administrativ|secretaria|secretario|recepcionista|recursos humanos|rrhh|talento humano|contador|contabilidad|finanzas|financiero|tesorer|compras|credito|auditor/.test(texto)\n    ){\n      return \"Administración y Finanzas\";\n    }\n\n    if(\n      /docente|profesor|maestro|educacion|educativo|pedagogia|tutor|instructor|capacitador|colegio|universidad|instituto|docencia/.test(texto)\n    ){\n      return \"Educación\";\n    }\n\n    return \"Otros\";\n\n  }\n\n  function claseCategoria(categoria){\n\n    var texto = normalizarCategoria(categoria);\n\n    if(texto === \"Ingeniería\"){\n      return \"visual-ingenieria\";\n    }\n\n    if(texto === \"Salud\"){\n      return \"visual-salud\";\n    }\n\n    if(texto === \"Ventas y Servicios\"){\n      return \"visual-ventas-servicios\";\n    }\n\n    if(texto === \"Administración y Finanzas\"){\n      return \"visual-administracion-finanzas\";\n    }\n\n    if(texto === \"Derecho\"){\n      return \"visual-derecho\";\n    }\n\n    if(texto === \"Educación\"){\n      return \"visual-educacion\";\n    }\n\n    return \"visual-otros\";\n\n  }\n\n  function iconoCategoria(categoria){\n\n    var categoriaNormalizada = normalizarCategoria(categoria);\n\n    if(categoriaNormalizada === \"Ingeniería\"){\n\n      return \u0027\u003csvg viewBox=\"0 0 24 24\" aria-hidden=\"true\"\u003e\u003cpath d=\"M4 20h16\"\u003e\u003c/path\u003e\u003cpath d=\"M6 20V8l6-4 6 4v12\"\u003e\u003c/path\u003e\u003cpath d=\"M9 20v-5h6v5\"\u003e\u003c/path\u003e\u003cpath d=\"M9 10h1\"\u003e\u003c/path\u003e\u003cpath d=\"M14 10h1\"\u003e\u003c/path\u003e\u003c/svg\u003e\u0027;\n\n    }\n\n    if(categoriaNormalizada === \"Salud\"){\n\n      return \u0027\u003csvg viewBox=\"0 0 24 24\" aria-hidden=\"true\"\u003e\u003cpath