c/li\u003e\n  \u003c/ul\u003e\n\u003c/div\u003e\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n  \u003ch2\u003eResultados y siguientes pasos\u003c/h2\u003e\n  \n  \u003cp\u003eCada etapa se resuelve seg n el cronograma que publican las bases; la entidad indica all  las fechas y el medio de publicaci n de cada resultado.\u003c/p\u003e\n  \u003cp\u003eSi no quedas seleccionado, revisa los requisitos del puesto y vuelve a intentarlo: los procesos del Estado se abren de forma peri dica.\u003c/p\u003e\n\u003c/div\u003e\n\n\u003cdiv class=\"empleo-postular\"\u003e\n  \u003ch2\u003e Te interesa esta convocatoria?\u003c/h2\u003e\n  \n  \u003ca\n    class=\"empleo-boton\"\n    href=\"https://www.invermet.gob.pe/wp-content/uploads/2026/09/BASES-CAS-52-1.pdf\"\n    target=\"_blank\"\n    rel=\"noopener noreferrer\"\n  \u003e\n    POSTULA AQU \n  \u003c/a\u003e\n  \u003cdiv class=\"empleo-aviso\"\u003e\n    Antes de postular revisa las bases y el cronograma oficiales.\n  \u003c/div\u003e\n\u003c/div\u003e\n\n\u003cdiv class=\"ofertas-relacionadas\"\u003e\n  \u003ch2\u003eConvocatorias relacionadas\u003c/h2\u003e\n  \u003cdiv id=\"ofertasRelacionadas\" class=\"relacionados-grid\"\u003e\u003c/div\u003e\n\u003c/div\u003e\n\n\u003c/div\u003e\n","fechaEncolada":"2026-10-05T23:12:25.2297090-05:00","estado":"CORREGIDA","aplicadaEn":"2026-10-06T00:45:53.1362399-05:00"}
