3e\n  \n  \u003cdiv class=\"empleo-destacado\"\u003e\n    \u003cp\u003e\u003cstrong\u003eVacantes:\u003c/strong\u003e 2\u003c/p\u003e\n    \u003cp\u003e\u003cstrong\u003eDirigido a:\u003c/strong\u003e Profesionales con Título Técnico Superior en las carreras Fuerzas Especiales o Defensa y Operaciones Especiales o Seguridad Militar o a fines; y/o Bachiller de la carrera universitaria en Administración o Ciencias Militares.\u003c/p\u003e\n    \u003cp\u003e\u003cstrong\u003eEstudios:\u003c/strong\u003e Título Técnico Superior en las carreras Fuerzas Especiales o Defensa y Operaciones Especiales o Seguridad Militar o a fines; y/o Bachiller de la carrera universitaria en Administración o Ciencias Militares.\u003c/p\u003e\n    \u003cp\u003e\u003cstrong\u003eExperiencia:\u003c/strong\u003e Experiencia General: mínima de tres (3) años laborando en el sector público y/o privado. Además,  Experiencia Específica: mínima de un (1) año en puestos y/o funciones similares o equivalentes en el sector público o privado.\u003c/p\u003e\n  \u003c/div\u003e\n\u003c/div\u003e\n\n\u003cdiv class=\"empleo-anuncio\"\u003e\n  Espacio publicitario\n\u003c/div\u003e\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n  \u003ch2\u003eLo que ofrece esta convocatoria\u003c/h2\u003e\n  \n  \u003cdiv class=\"empleo-destacado\"\u003e\n    \u003cp\u003e\u003cstrong\u003eRemuneración:\u003c/strong\u003e S/ 5000.00\u003c/p\u003e\n    \u003cp\u003e\u003cstrong\u003eEntidad:\u003c/strong\u003e MUNICIPALIDAD SURQUILLO\u003c/p\u003e\n    \u003cp\u003e\u003cstrong\u003eUbicación:\u003c/strong\u003e Surquillo, Lima, Perú\u003c/p\u003e\n    \u003cp\u003e\u003cstrong\u003eFecha de publicación:\u003c/strong\u003e 29/09/2026\u003c/p\u003e\n    \u003cp\u003e\u003cstrong\u003eFecha de cierre:\u003c/strong\u003e 14/10/2026\u003c/p\u003e\n  \u003c/div\u003e\n\u003c/div\u003e\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n  \u003ch2\u003ePasos para postular\u003c/h2\u003e\n  \n  \u003cdiv class=\"empleo-destacado\"\u003e\n   