leo-seccion h2{\n    font-size:18px;\n  }\n\n  .empleo-anuncio{\n    min-height:70px;\n  }\n\n  .empleo-boton{\n    width:100%;\n  }\n\n  .relacionados-grid{\n    display:flex;\n    overflow-x:auto;\n    gap:12px;\n    padding-bottom:5px;\n    scroll-snap-type:x mandatory;\n  }\n\n  .relacionado-card{\n    flex:0 0 84%;\n    scroll-snap-align:start;\n  }\n}\n\n@media(max-width:380px){\n\n  .relacionado-card{\n    flex-basis:91%;\n  }\n}\n\u003c/style\u003e\n\n\n\u003cdiv class=\"empleo-cabecera\"\u003e\n\n  \u003cdiv class=\"empleo-fuente\"\u003eFuente: Bumeran\u003c/div\u003e\n\n  \u003cdiv class=\"empleo-categoria\"\u003eIngeniería\u003c/div\u003e\n\n  \u003ch1\u003eArquitecto Residente de Obra / Edificios Multifamiliares / Trujillo\u003c/h1\u003e\n\n  \u003cdiv class=\"empleo-empresa\"\u003eADECCO PERU S.A.\u003c/div\u003e\n\n  \u003cdiv class=\"empleo-salario-header\"\u003e\n    No especificado\u003c/div\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-info\"\u003e\n\n  \u003cdiv class=\"empleo-info-card\"\u003e\n    \u003cdiv class=\"empleo-info-label\"\u003eUbicación\u003c/div\u003e\n    \u003cdiv class=\"empleo-info-value\"\u003eTrujillo, La Libertad, Peru\u003c/div\u003e\n  \u003c/div\u003e\n\n  \u003cdiv class=\"empleo-info-card\"\u003e\n    \u003cdiv class=\"empleo-info-label\"\u003eModalidad\u003c/div\u003e\n    \u003cdiv class=\"empleo-info-value\"\u003ePresencial\u003c/div\u003e\n  \u003c/div\u003e\n\n  \u003cdiv class=\"empleo-info-card\"\u003e\n    \u003cdiv class=\"empleo-info-label\"\u003eContrato\u003c/div\u003e\n    \u003cdiv class=\"empleo-info-value\"\u003eFull-time, Indeterminado\u003c/div\u003e\n  \u003c/div\u003e\n\n  \u003cdiv class=\"empleo-info-card\"\u003e\n    \u003cdiv class=\"empleo-info-label\"\u003eSalario\u003c/div\u003e\n    \u003cdiv class=\"empleo-info-value\"\u003eRemuneración acorde al mercado\u003c/div\u003e\n  \u003c/div\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-anuncio\"\u003e\n  Espacio publicitario\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n\n  \u003ch2\u003eDescripción del puesto\u003c/h2\u003e\n\n  \u003cp\u003e\n    En Adecco Perú, firma global especializada en atracción y selección de personal, nos encontramos en búsqueda del mejor talento para cubrir la siguiente vacante.\n  \u003c/p\u003e\n\n  \u003cp\u003e\n    Por encargo de nuestro cliente, importante empresa constructora e inmobiliaria se encuentra en la búsqueda de un(a) Residente de Obra para liderar proyectos de edificaciones multifamiliares en la ciudad de Trujillo.\n  \u003c/p\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-anuncio\"\u003e\n  Espacio publicitario\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n\n  \u003ch2\u003eFunciones\u003c/h2\u003e\n\n  \u003cul\u003e\n    \u003cli\u003eSupervisar y realizar seguimiento a contratistas de obra.\u003c/li\u003e\n    \u003cli\u003eCoordinar las diferentes especialidades involucradas en el proyecto.\u003c/li\u003e\n    \u003cli\u003eAsegurar la calidad de los trabajos ejecutados.\u003c/li\u003e\n    \u003cli\u003eValidar valorizaciones y verificar metrados de contratistas.\u003c/li\u003e\n    \u003cli\u003eReportar avances, incidencias y desviaciones a la gerencia.\u003c/li\u003e\n    \u003cli\u003eVelar por la correcta compatibilización de especialidades.\u003c/li\u003e\n  \u003c/ul\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n\n  \u003ch2\u003eRequisitos\u003c/h2\u003e\n\n  \u003cul\u003e\n    \u003cli\u003eBachiller en Arquitectura (indispensable).\u003c/li\u003e\n    \u003cli\u003eExperiencia mínima de 3 a 4 años como Residente de Obra en proyectos de edificios multifamiliares de 10 pisos o más.\u003c/li\u003e\n    \u003cli\u003eManejo de Excel a nivel intermedio.\u003c/li\u003e\n    \u003cli\u003eConocimientos en construcción de casco habitable, acabados, metrados, valorizaciones, PMI, Revit, AutoCAD y gestión de personas.\u003c/li\u003e\n    \u003cli\u003eLiderazgo, planificación y gestión, pensamiento estratégico, capacidad de análisis y comunicación efectiva.\u003c/li\u003e\n  \u003c/ul\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-anuncio\"\u003e\n  Espacio publicitario\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n\n  \u003ch2\u003eInformación de la oferta\u003c/h2\u003e\n\n  \u003cdiv class=\"empleo-destacado\"\u003e\n\n    \u003cp\u003e\u003cstrong\u003eVacantes:\u003c/strong\u003e 1\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eJornada:\u003c/strong\u003e Lunes a viernes de 8:00 a.m. a 6:00 p.m. y sábados de 8:00 a.m. a 1:00 p.m.\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eContrato:\u003c/strong\u003e Full-time, Indeterminado\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eModalidad:\u003c/strong\u003e Presencial\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eExperiencia:\u003c/strong\u003e Experiencia mínima de 3 a 4 años como Residente de Obra en proyectos de edificios multifamiliares de 10 pisos o más.\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eEstudios:\u003c/strong\u003e Bachiller en Arquitectura (indispensable).\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eSalario:\u003c/strong\u003e No especificado\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eFecha publicación:\u003c/strong\u003e 07/09/2026\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eFecha cierre:\u003c/strong\u003e No especificada en la publicación\u003c/p\u003e\n    \n    \u003cp\u003e\u003cstrong\u003eTipo contratante:\u003c/strong\u003e Privado\u003c/p\u003e\n\n\n  \u003c/div\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n\n  \u003ch2\u003eBeneficios\u003c/h2\u003e\n\n  \u003cul\u003e\n    \u003cli\u003eIngreso a planilla PYME.\u003c/li\u003e\n    \u003cli\u003eOportunidad de crecimiento y desarrollo profesional.\u003c/li\u003e\n    \u003cli\u003eRemuneración acorde al mercado.\u003c/li\u003e\n    \u003cli\u003eNo especificado\u003c/li\u003e\n  \u003c/ul\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-anuncio\"\u003e\n  Espacio publicitario\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n\n  \u003ch2\u003eInformación de la empresa\u003c/h2\u003e\n\n  \u003cdiv class=\"empleo-destacado\"\u003e\n\n    \u003cp\u003e\u003cstrong\u003eEmpresa:\u003c/strong\u003e ADECCO PERU S.A.\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eSector:\u003c/strong\u003e No especificado en la publicación\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eTamaño:\u003c/strong\u003e No especificado en la publicación\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eUbicación:\u003c/strong\u003e No especificado en la publicación\u003c/p\u003e\n\n    \u003cp\u003e\n      \u003cstrong\u003eDescripción:\u003c/strong\u003e\n      En Adecco Perú, firma global especializada en atracción y selección de personal.\n    \u003c/p\u003e\n\n  \u003c/div\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-anuncio\"\u003e\n  Espacio publicitario\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-postular\"\u003e\n\n  \u003ch2\u003e¿Te interesa esta oferta?\u003c/h2\u003e\n\n  \u003ca\n    class=\"empleo-boton\"\n    href=\"https://www.bumeran.com.pe/empleos/arquitecto-residente-de-obra-edificios-multifamiliares-trujillo-adecco-peru-s.a.-1118431555.html\"\n    target=\"_blank\"\n    rel=\"noopener noreferrer\"\n  \u003e\n    POSTULAR EN BUMERAN\n  \u003c/a\u003e\n\n  \u003cdiv class=\"empleo-aviso\"\u003e\n    La postulación se realiza directamente en la plataforma de origen.\n  \u003c/div\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"ofertas-relacionadas\"\u003e\n\n  \u003ch2\u003eOfertas recomendadas para ti\u003c/h2\u003e\n\n  \u003cdiv id=\"ofertasRelacionadas\" class=\"relacionados-grid\"\u003e\u003c/div\u003e\n\n\u003c/div\u003e\n\n\n\u003cscript\u003e\n(function(){\n\n  \"use strict\";\n\n  var CONTENEDOR_ID = \"ofertasRelacionadas\";\n\n  function normalizarTexto(texto){\n\n    return String(texto || \"\")\n      .r