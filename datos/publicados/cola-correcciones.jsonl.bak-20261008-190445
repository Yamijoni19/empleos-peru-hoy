));\n  gap:14px;\n}\n\n.relacionado-card{\n  background:#fff;\n  border:1px solid #e5e7eb;\n  border-radius:15px;\n  overflow:hidden;\n  box-shadow:0 3px 10px rgba(0,0,0,.06);\n  transition:transform .2s,box-shadow .2s;\n  display:flex;\n  flex-direction:column;\n}\n\n.relacionado-card:hover{\n  transform:translateY(-2px);\n  box-shadow:0 6px 15px rgba(0,0,0,.1);\n}\n\n.relacionado-visual{\n  height:75px;\n  padding:10px 13px;\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  color:#fff;\n}\n\n.relacionado-etiqueta{\n  background:rgba(255,255,255,.18);\n  border:1px solid rgba(255,255,255,.25);\n  border-radius:20px;\n  padding:4px 9px;\n  font-size:10px;\n  font-weight:700;\n}\n\n.relacionado-icono{\n  width:39px;\n  height:39px;\n  border-radius:50%;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  background:rgba(255,255,255,.15);\n  border:1px solid rgba(255,255,255,.28);\n  color:#fff;\n  flex:0 0 39px;\n}\n\n.relacionado-icono svg{\n  width:21px;\n  height:21px;\n  display:block;\n  stroke:currentColor;\n  fill:none;\n  stroke-width:1.8;\n  stroke-linecap:round;\n  stroke-linejoin:round;\n}\n\n.relacionado-contenido{\n  padding:13px 14px 14px;\n  display:flex;\n  flex-direction:column;\n  flex:1;\n}\n\n.relacionado-titulo{\n  color:#1f2937;\n  font-size:16px;\n  line-height:1.3;\n  font-weight:700;\n  margin-bottom:5px;\n  display:-webkit-box;\n  -webkit-line-clamp:2;\n  -webkit-box-orient:vertical;\n  overflow:hidden;\n}\n\n.relacionado-empresa{\n  color:#6b7280;\n  font-size:11px;\n  margin-bottom:8px;\n  white-space:nowrap;\n  overflow:hidden;\n  text-overflow:ellipsis;\n}\n\n.relacionado-datos{\n  display:flex;\n  flex-wrap:wrap;\n  gap:5px;\n  margin-bottom:8px;\n}\n\n.relacionado-chip{\n  background:#f3f4f6;\n  color:#4b5563;\n  border-radius:12px;\n  padding:3px 7px;\n  font-size:9px;\n  font-weight:600;\n}\n\n.relacionado-salario{\n  color:#1976d2;\n  font-size:14px;\n  font-weight:700;\n  margin-bottom:5