\u003e\n  Espacio publicitario\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n\n  \u003ch2\u003eDescripción del puesto\u003c/h2\u003e\n\n  \u003cp\u003e\n    No especificado en la publicación.\n  \u003c/p\u003e\n\n  \u003cp\u003e\n    No especificado en la publicación.\n  \u003c/p\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-anuncio\"\u003e\n  Espacio publicitario\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n\n  \u003ch2\u003eFunciones\u003c/h2\u003e\n\n  \u003cul\u003e\n    \u003cli\u003eProspectar y desarrollar oportunidades comerciales en los sectores hotelero, hospitalario, educativo e industrial.\u003c/li\u003e\n    \u003cli\u003eGestionar oportunidades y proyectos desde la prospección hasta el cierre técnico-comercial.\u003c/li\u003e\n    \u003cli\u003eVisitar clientes, constructoras, firmas de ingeniería y especificadores para presentar soluciones.\u003c/li\u003e\n    \u003cli\u003eLevantar información técnica y realizar cálculos para el diseño y dimensionamiento de sistemas de agua caliente.\u003c/li\u003e\n    \u003cli\u003eSeleccionar y dimensionar calentadores, tanques, bombas, válvulas mezcladoras y demás componentes del sistema.\u003c/li\u003e\n    \u003cli\u003eElaborar propuestas técnico-económicas, comparativos, análisis de eficiencia, costos operativos y ROI.\u003c/li\u003e\n    \u003cli\u003eBrindar soporte técnico a clientes y a la base instalada, identificando oportunidades de mejora, ampliación o reemplazo.\u003c/li\u003e\n    \u003cli\u003eCoordinar instalaciones, arranques, servicios técnicos y proyectos con equipos internos y externos.\u003c/li\u003e\n    \u003cli\u003eCapacitar a personal de operación y mantenimiento sobre el funcionamiento y buenas prácticas de los sistemas.\u003c/li\u003e\n    \u003cli\u003eElaborar hojas de datos, criterios de selección, planos funcionales y documentación técnica.\u003c/li\u003e\n    \u003cli\u003eRegistrar y dar seguimiento a oportunidades, cotizaciones, avances y compromisos mediante CRM.\u003c/li\u003e\n    \u003cli\u003eCoordinar con las áreas de soporte técnico, cotizaciones, operaciones y fábrica para asegurar la correcta ejecución de los proyectos.\u003c/li\u003e\n  \u003c/ul\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n\n  \u003ch2\u003eRequisitos\u003c/h2\u003e\n\n  \u003cul\u003e\n    \u003cli\u003eIngeniería Mecánica, Mecatrónica, Energía o afín.\u003c/li\u003e\n    \u003cli\u003eExperiencia mínima de 6 años en proyectos térmicos, HVAC o sistemas hidráulicos.\u003c/li\u003e\n    \u003cli\u003eLicencia de conducir vigente. Licencia de conducir A-I.\u003c/li\u003e\n    \u003cli\u003eVisa americana vigente para entrenamiento en sede de la marca en Estados Unidos.\u003c/li\u003e\n    \u003cli\u003eEducación mínima: Técnico. La publicación también indica Ingeniería Mecánica, Mecatrónica, Energía o afín.\u003c/li\u003e\n    \u003cli\u003eTermodinámica aplicada al agua caliente (Q = m·Cp·ΔT).\u003c/li\u003e\n    \u003cli\u003eHidráulica: recirculación, pérdidas de carga, expansión térmica.\u003c/li\u003e\n    \u003cli\u003eDiseño de sistemas de agua caliente (tanques, bombas, aislamiento, distribución).\u003c/li\u003e\n    \u003cli\u003eSelección de calentadores y controles (gas natural/GLP).\u003c/li\u003e\n    \u003cli\u003eSelección y uso de válvulas mezcladoras digitales De la Marca (BRAIN, EMECH).\u003c/li\u003e\n    \u003cli\u003eFundamentos de micro/nanoburbujas y su interacción con sistemas de agua caliente; criterios básicos de instalación y dimensionamiento.\u003c/li\u003e\n    \u003cli\u003eNormas sanitarias (prevención de Legionella, ASHRAE básico).\u003c/li\u003e\n    \u003cli\u003eInterpretación de P\u0026amp;ID, planos unifilares e IOMs.\u003c/li\u003e\n    \u003cli\u003eDominio de Excel técnico y nociones de AutoCAD.\u003c/li\u003e\n    \u003cli\u003eComunicación clara y persuasiva en contexto técnico.\u003c/li\u003e\n    \u003cli\u003eCapacidad de cerrar ventas por mérito técnico y económico.\u003c/li\u003e\n    \u003cli\u003eGeneración y gestión de oportunidades en CRM.\u003c/li\u003e\n    \u003cli\u003ePreparación de presentaciones técnico-comerciales ejecutivas.\u003c/li\u003e\n    \u003cli\u003eProactividad, autonomía y orden.\u003c/li\u003e\n    \u003cli\u003eCapacidad para priorizar, negociar y tomar decisiones técnicas.\u003c/li\u003e\n    \u003cli\u003eAlta movilidad nacional.\u003c/li\u003e\n    \u003cli\u003eDisponibilidad de viajar: Sí.\u003c/li\u003e\n  \u003c/ul\u003e\n\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-anuncio\"\u003e\n  Espacio publicitario\n\u003c/div\u003e\n\n\n\u003cdiv class=\"empleo-seccion\"\u003e\n\n  \u003ch2\u003eInformación de la oferta\u003c/h2\u003e\n\n  \u003cdiv class=\"empleo-destacado\"\u003e\n\n    \u003cp\u003e\u003cstrong\u003eVacantes:\u003c/strong\u003e No especificado en la publicación.\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eJornada:\u003c/strong\u003e Tiempo completo\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eContrato:\u003c/strong\u003e Contrato por Inicio o Incremento de Actividad\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eModalidad:\u003c/strong\u003e Presencial\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eExperiencia:\u003c/strong\u003e Experiencia mínima de 6 años en proyectos térmicos, HVAC o sistemas hidráulicos. En la sección Requerimientos también se indica 5 años de experiencia.\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eEstudios:\u003c/strong\u003e Educación mínima: Técnico. También se requiere Ingeniería Mecánica, Mecatrónica, Energía o afín.\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eSalario:\u003c/strong\u003e S/ 4.000,00\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eFecha publicación:\u003c/strong\u003e No especificada en la publicación.\u003c/p\u003e\n\n    \u003cp\u003e\u003cstrong\u003eFecha cierre:\u003c/strong\u003e No especificada en la publicación\u003c/p\u003e\n    \n    \u003cp\u003e\u003cstrong