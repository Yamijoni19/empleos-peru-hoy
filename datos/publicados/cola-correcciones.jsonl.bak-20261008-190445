e\n    Antes de postular revisa las bases y el cronograma oficiales.\n  \u003c/div\u003e\n\u003c/div\u003e\n\n\u003cdiv class=\"ofertas-relacionadas\"\u003e\n  \u003ch2\u003eConvocatorias relacionadas\u003c/h2\u003e\n  \u003cdiv id=\"ofertasRelacionadas\" class=\"relacionados-grid\"\u003e\u003c/div\u003e\n\u003c/div\u003e\n\n\u003c/div\u003e\n","motivo":"FASE-A: cat:Administracion y Finanzas-\u003eAdministración y Finanzas","prioridad":0,"fechaEncolada":"2026-10-08T17:31:51.4412413-05:00","estado":"CORREGIDA","aplicadaEn":"2026-10-08T17:48:17.9215898-05:00"}
